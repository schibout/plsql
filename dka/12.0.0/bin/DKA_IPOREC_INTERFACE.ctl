OPTIONS (SKIP=1) 
LOAD DATA
APPEND
INTO TABLE DKA_IPOREC_INTERFACE FIELDS TERMINATED BY '|'    TRAILING NULLCOLS(
RECEIPT_NUM	         CHAR   NULLIF (RECEIPT_NUM= BLANKS),
ORG                  CHAR   NULLIF (ORG= BLANKS),
VENDOR_NUM	         CHAR   NULLIF (VENDOR_NUM= BLANKS),
VENDOR_SITE_CODE	 CHAR   NULLIF (VENDOR_SITE_CODE  = BLANKS),
ID_SITE_IVALUA       CHAR   NULLIF (ID_SITE_IVALUA= BLANKS),
RECEIPT_DATE         DATE   'DD/MM/YYYY HH24:MI:SS'  NULLIF (RECEIPT_DATE= BLANKS),
BORDEREAU_NUM        CHAR   NULLIF (BORDEREAU_NUM = BLANKS),
COMMENTAIRE          CHAR   NULLIF (COMMENTAIRE= BLANKS),
TRANSACTION_TYPE     CHAR   NULLIF (TRANSACTION_TYPE= BLANKS),
DOCUMENT_NUM         CHAR   NULLIF (DOCUMENT_NUM= BLANKS),
ID_LIGNE_IVALUA      CHAR   NULLIF (ID_LIGNE_IVALUA= BLANKS),
QUANTITY             "REPLACE(:QUANTITY,',','.')" ,
FLAG_REC_FINALE      "REPLACE( :Flag_rec_finale,CHR(13),'')", -- CHAR NULLIF (FLAG_REC_FINALE= BLANKS),  -- "REPLACE( :Flag_rec_finale,CHR(13),'')",
ID_MVT_REC           CHAR   NULLIF (ID_MVT_REC  = BLANKS),
ID_MVT_ORIGINE       "REPLACE( :ID_MVT_ORIGINE,CHR(13),'')",
CREATION_DATE	     SYSDATE,
CREATED_BY	         CONSTANT '!USER_ID!' , 
LAST_UPDATE_DATE	 SYSDATE,
LAST_UPDATED_BY	     CONSTANT '!USER_ID!' , 
STATUT	             CONSTANT "NEW",
FILE_NAME	         CONSTANT '!FILE_NAME!',
LINE_NUM	         RECNUM,
RECORD_ID            "DKA_IPOREC_INTERFACE_S.NEXTVAL",
REQUEST_ID	         CONSTANT '-1',
LOADER_REQUEST_ID	 CONSTANT '!LOAD_REQUEST_ID!',
INTERFACE_TRANSACTION_ID CONSTANT '0',
shipment_line_id     CHAR   NULLIF (shipment_line_id= BLANKS),
TRANSACTION_ID       CHAR   NULLIF (TRANSACTION_ID= BLANKS),
PARENT_TRANSACTION_ID CHAR   NULLIF (PARENT_TRANSACTION_ID= BLANKS),
vendor_id            CHAR   NULLIF (vendor_id= BLANKS),
ORG_ID               CHAR   NULLIF (ORG_ID= BLANKS),
VENDOR_SITE_ID       CHAR   NULLIF (VENDOR_SITE_ID= BLANKS),
Receipt_date_new     CHAR   NULLIF (Receipt_date_new= BLANKS),
CMD_ID               CHAR   NULLIF (CMD_ID= BLANKS),
LIGNE_ID             CHAR   NULLIF (LIGNE_ID= BLANKS),
UNIT_OF_MEASURE      CHAR   NULLIF (UNIT_OF_MEASURE= BLANKS),
LINE_LOCATION_ID     CHAR   NULLIF (LINE_LOCATION_ID= BLANKS),
PO_DISTRIBUTION_ID   CHAR   NULLIF (PO_DISTRIBUTION_ID= BLANKS)
)
