----------------------------------------------------------------------
-- APPELE PAR : DKA_APIMPFRSIVALUA_LOADER                                 -
-- FONCTION   : Fichier de controle sql*loader                       -
--              import founisseur                                   -
--              Fichier plat des banques fournisseur                 -
--                                                                   -
----------------------------------------------------------------------
-- Version              : 1.0                                        -
-- PROGRAMME MODIFIE LE :                                            -
-- PAR                  :                                            -
-- OBJET                :                                            -
--                                                                   -
----------------------------------------------------------------------
OPTIONS (ERRORS=0,SKIP=1)
LOAD DATA
APPEND
INTO TABLE DKA_IPOFRS_ENTETES
FIELDS TERMINATED BY "|" 
TRAILING NULLCOLS
(
 NUM_FOURNISSEUR            POSITION(1) "RTRIM(LTRIM(:NUM_FOURNISSEUR))"
,NOM_FOURNISSEUR	        "RTRIM(LTRIM(:NOM_FOURNISSEUR))"
,AUTRE_NOM_FOURNISSEUR      "RTRIM(LTRIM(:AUTRE_NOM_FOURNISSEUR))"
,ID_FISCALE             	"RTRIM(LTRIM(:ID_FISCALE))"
,NUM_ID_INTRACOMMUNAUTAIRE	"RTRIM(LTRIM(:NUM_ID_INTRACOMMUNAUTAIRE))"
,CODE_DAS2					"RTRIM(LTRIM(:CODE_DAS2))"
,CODE_NAF					"RTRIM(LTRIM(:CODE_NAF))"
,NUM_SOCIETE_MERE 			"RTRIM(LTRIM(:NUM_SOCIETE_MERE))"
,OCCASIONNEL				"RTRIM(LTRIM(:OCCASIONNEL))"
,TYPE						"RTRIM(LTRIM(:TYPE))"
,SOUS_TYPE                  "RTRIM(LTRIM(:SOUS_TYPE))"
,FOURNISSEUR_SERVICES       "RTRIM(LTRIM(:FOURNISSEUR_SERVICES))"
,FOURNISSEUR_COMBUSTIBLES   "RTRIM(LTRIM(:FOURNISSEUR_COMBUSTIBLES))"
,FOURNISSEUR_VEHICULES      "RTRIM(LTRIM(:FOURNISSEUR_VEHICULES))"
,CODE_ACCORD                "RTRIM(LTRIM(:CODE_ACCORD))"
,CODE_SURTAXE_COM           "RTRIM(LTRIM(:CODE_SURTAXE_COM))"
,CODE_PARTENAIRE            "REPLACE( :CODE_PARTENAIRE,CHR(13),'')"
,CREATION_DATE			    SYSDATE
,CREATED_BY				    CONSTANT '!USER_ID!'
,LAST_UPDATE_DATE		    SYSDATE
,LAST_UPDATED_BY 		    CONSTANT '!USER_ID!'
,STATUT             	    CONSTANT "NEW"
,FILE_NAME				    CONSTANT '!FILE_NAME!'
,LINE_NUM                   RECNUM
,RECORD_ID                  "DKA_IPOFRS_ENTETES_S.NEXTVAL"
,REQUEST_ID                 CONSTANT '-1'
,LOADER_REQUEST_ID          CONSTANT '!LOAD_REQUEST_ID!'
)

INTO TABLE DKA_IPOFRS_REPORTING_ENTETES   
FIELDS TERMINATED BY '|'
TRAILING NULLCOLS
(
 NUM_FOURNISSEUR            POSITION(1) "RTRIM(LTRIM(:NUM_FOURNISSEUR))"
,NOM_FOURNISSEUR	        "RTRIM(LTRIM(:NOM_FOURNISSEUR))"
,AUTRE_NOM_FOURNISSEUR      "RTRIM(LTRIM(:AUTRE_NOM_FOURNISSEUR))"
,ID_FISCALE             	"RTRIM(LTRIM(:ID_FISCALE))"
,NUM_ID_INTRACOMMUNAUTAIRE	"RTRIM(LTRIM(:NUM_ID_INTRACOMMUNAUTAIRE))"
,CODE_DAS2					"RTRIM(LTRIM(:CODE_DAS2))"
,CODE_NAF					"RTRIM(LTRIM(:CODE_NAF))"
,NUM_SOCIETE_MERE 			"RTRIM(LTRIM(:NUM_SOCIETE_MERE))"
,OCCASIONNEL				"RTRIM(LTRIM(:OCCASIONNEL))"
,TYPE						"RTRIM(LTRIM(:TYPE))"
,SOUS_TYPE                  "RTRIM(LTRIM(:SOUS_TYPE))"
,FOURNISSEUR_SERVICES       "RTRIM(LTRIM(:FOURNISSEUR_SERVICES))"
,FOURNISSEUR_COMBUSTIBLES   "RTRIM(LTRIM(:FOURNISSEUR_COMBUSTIBLES))"
,FOURNISSEUR_VEHICULES      "RTRIM(LTRIM(:FOURNISSEUR_VEHICULES))"
,CODE_ACCORD                "RTRIM(LTRIM(:CODE_ACCORD))"
,CODE_SURTAXE_COM           "RTRIM(LTRIM(:CODE_SURTAXE_COM))"
,CODE_PARTENAIRE            "REPLACE( :CODE_PARTENAIRE,CHR(13),'')"
,CREATION_DATE			    SYSDATE
,CREATED_BY				    CONSTANT '!USER_ID!'
,LAST_UPDATE_DATE		    SYSDATE
,LAST_UPDATED_BY 		    CONSTANT '!USER_ID!'
,STATUT             	    CONSTANT "NEW"
,FILE_NAME				    CONSTANT '!FILE_NAME!'
,LINE_NUM                   RECNUM
,REQUEST_ID                 CONSTANT '-1'
,LOADER_REQUEST_ID          CONSTANT '!LOAD_REQUEST_ID!'
)

INTO TABLE DKA_IPOFRS_HIST_ENTETES   
FIELDS TERMINATED BY '|'
TRAILING NULLCOLS
(
 NUM_FOURNISSEUR            POSITION(1) "RTRIM(LTRIM(:NUM_FOURNISSEUR))"
,NOM_FOURNISSEUR	        "RTRIM(LTRIM(:NOM_FOURNISSEUR))"
,AUTRE_NOM_FOURNISSEUR      "RTRIM(LTRIM(:AUTRE_NOM_FOURNISSEUR))"
,ID_FISCALE             	"RTRIM(LTRIM(:ID_FISCALE))"
,NUM_ID_INTRACOMMUNAUTAIRE	"RTRIM(LTRIM(:NUM_ID_INTRACOMMUNAUTAIRE))"
,CODE_DAS2					"RTRIM(LTRIM(:CODE_DAS2))"
,CODE_NAF					"RTRIM(LTRIM(:CODE_NAF))"
,NUM_SOCIETE_MERE 			"RTRIM(LTRIM(:NUM_SOCIETE_MERE))"
,OCCASIONNEL				"RTRIM(LTRIM(:OCCASIONNEL))"
,TYPE						"RTRIM(LTRIM(:TYPE))"
,SOUS_TYPE                  "RTRIM(LTRIM(:SOUS_TYPE))"
,FOURNISSEUR_SERVICES       "RTRIM(LTRIM(:FOURNISSEUR_SERVICES))"
,FOURNISSEUR_COMBUSTIBLES   "RTRIM(LTRIM(:FOURNISSEUR_COMBUSTIBLES))"
,FOURNISSEUR_VEHICULES      "RTRIM(LTRIM(:FOURNISSEUR_VEHICULES))"
,CODE_ACCORD                "RTRIM(LTRIM(:CODE_ACCORD))"
,CODE_SURTAXE_COM           "RTRIM(LTRIM(:CODE_SURTAXE_COM))"
,CODE_PARTENAIRE            "REPLACE( :CODE_PARTENAIRE,CHR(13),'')"
,CREATION_DATE			    SYSDATE
,CREATED_BY				    CONSTANT '!USER_ID!'
,LAST_UPDATE_DATE		    SYSDATE
,LAST_UPDATED_BY 		    CONSTANT '!USER_ID!'
,STATUT             	    CONSTANT "NEW"
,FILE_NAME				    CONSTANT '!FILE_NAME!'
,LINE_NUM                   RECNUM
,REQUEST_ID                 CONSTANT '-1'
,LOADER_REQUEST_ID          CONSTANT '!LOAD_REQUEST_ID!'
)


--FIN 


