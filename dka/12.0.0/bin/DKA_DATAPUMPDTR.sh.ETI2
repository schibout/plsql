# repertoire contenant les fichiers dmp, log et tar.gz
#DKA_DATA_PUMP_DIR=/data/flf/files/DATAPUMP
DKA_DATA_PUMP_DIR=/data/flf/files/PDBFINI2/datapump

#ARA
logfile_sql=DKA_TABLES_DTR_$(date +%Y%m%d%H%M%S)_SQL.log

# nom du fichier dum
DUMP_FILE_NAME=FIN01_$(date +%Y%m%d%H%M%S)_FINACHATSGLOBAL_001_$6_$1
# code retour
SHELL_RES=0

# extraction via l outil expdp
# parametre 1: date au format YYYYMMDD
# parametre 2: identifiant
# parametre 3: mot de passe
# parametre 4: nom de l instance
# parametre 5: nom de l objet repertoire
# parametre 6: date debut extraction YYYYMMDD

echo "\n==> script DKA_TABLES_DTR.sql" | tee -a $DKA_DATA_PUMP_DIR/$logfile_sql
sqlplus $2/$3 @$DKA_TOP/sql/DKA_TABLES_DTR.sql $6 | tee -a $DKA_DATA_PUMP_DIR/$logfile_sql


