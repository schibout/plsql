:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",PO.PO_HEADERS_ARCHIVE_ALL:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",IBY.IBY_PAYMENTS_ALL:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",DKA.DKA_SAP_STATUT_FACTURE:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_ADJUSTMENTS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_TRANSACTION_HEADERS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_RETIREMENTS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_CALENDAR_PERIODS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_BOOKS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_DEPRN_DETAIL:\"WHERE DEPRN_RUN_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_BOOK_CONTROLS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_ASSET_INVOICES:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_DISTRIBUTION_HISTORY:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_LOCATIONS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",PA.PA_PROJECT_ASSET_LINES_ALL:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",PA.PA_PROJECT_ASSET_LINE_DETAILS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_DEPRN_SUMMARY:\"WHERE DEPRN_RUN_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_MC_DEPRN_SUMMARY:\"WHERE DEPRN_RUN_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_MC_BOOKS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_MC_BOOK_CONTROLS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",FA.FA_DISTRIBUTION_ACCOUNTS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",PO.PO_REQUISITION_HEADERS_ALL:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\",AR.HZ_CUSTOMER_PROFILES:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" ,APPLSYS.FND_LOOKUP_VALUES:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" ,APPLSYS.FND_FLEX_VALUES_TL:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" ,AR.HZ_PARTIES:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" ,APPLSYS.WF_LOCAL_USER_ROLES:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" ,APPLSYS.FND_PROFILE_OPTION_VALUES:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" ,AR.AR_COLLECTORS:\"WHERE LAST_UPDATE_DATE>=TO_DATE('"$6"','YYYYMMDD')\" " >> $DKA_DATA_PUMP_DIR/DKA_DATAPUMPDTR.par
#echo 'DIRECTORY='$5 >> $DKA_DATA_PUMP_DIR/DKA_DATAPUMPDTR.par
#echo 'LOGFILE='$DUMP_FILE_NAME'.log' >> $DKA_DATA_PUMP_DIR/DKA_DATAPUMPDTR.par
#echo 'DUMPFILE='$DUMP_FILE_NAME'.dmp' >> $DKA_DATA_PUMP_DIR/DKA_DATAPUMPDTR.par

#$ORACLE_HOME/bin/expdp USERID=$2/$3@$4 parfile=$DKA_DATA_PUMP_DIR/DKA_DATAPUMPDTR.par
#if [ $? -ne 0 ]
#then
#   SHELL_RES=20
#fi
# archivage et compression des fichiers generes
# ARA
#$ORACLE_HOME/bin/expdp USERID=$2/$3@$4 parfile=$DKA_DATA_PUMP_DIR/DKA_DATAPUMPDTR.par


$ORACLE_HOME/bin/expdp USERID=$2/$3@$4 DIRECTORY=$5 DUMPFILE=$DUMP_FILE_NAME.dmp LOGFILE=$DUMP_FILE_NAME.log SCHEMAS=$2 VERSION=12.1

if [ -e $DKA_DATA_PUMP_DIR/$DUMP_FILE_NAME.dmp -o -e $DKA_DATA_PUMP_DIR/$DUMP_FILE_NAME.log -o -e $DKA_DATA_PUMP_DIR/$logfile_sql ]
then
	echo "GOTO dump directory"
	cd $DKA_DATA_PUMP_DIR
	if [ $? -ne 0 ]
	then
	   SHELL_RES=20
	fi
	
	#ARA
	echo "Archiving and compressiong the dump and log files : " $DUMP_FILE_NAME.dmp " and " $DUMP_FILE_NAME.log " and " $logfile_sql
	tar -czvf $DUMP_FILE_NAME.tar.gz $DUMP_FILE_NAME.dmp $DUMP_FILE_NAME.log $logfile_sql
	if [ $? -ne 0 ]
	then
	   SHELL_RES=20
	fi
	
	echo "Removing files (only keep tar.gz)" 
	rm -f $DUMP_FILE_NAME.dmp $DUMP_FILE_NAME.log $logfile_sql
	if [ $? -ne 0 ]
	then
	   SHELL_RES=20
	fi	
fi

if [ $SHELL_RES -eq 0 ] 
then
	echo "Operation successful - file created : " $DUMP_FILE_NAME.tar.gz
else
	echo "Operation failed"
fi

exit $SHELL_RES
