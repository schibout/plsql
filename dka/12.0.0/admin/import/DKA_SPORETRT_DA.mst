# $Header$

# dbdrv: exec fnd bin FNDLOAD bin &phase=daa+52 checkfile:~PROD:~PATH:~FILE &ui_apps 0 Y UPLOAD @FND:patch/115/import/afmdmsg.lct @~PROD:~PATH/~FILE
LANGUAGE = "US"
LDRCONFIG = "afmdmsg.lct 120.2.12020000.1"

#Source Database HELDEV

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE FND_NEW_MESSAGES
  KEY   APPLICATION_SHORT_NAME          VARCHAR2(50)
  KEY   MESSAGE_NAME                    VARCHAR2(30)
  CTX   OWNER                           VARCHAR2(4000)
  BASE  LAST_UPDATE_DATE                VARCHAR2(10)
  CTX   MESSAGE_NUMBER                  VARCHAR2(50)
  TRANS MESSAGE_TEXT                    VARCHAR2(2000)
  CTX   DESCRIPTION                     VARCHAR2(240)
  CTX   TYPE                            VARCHAR2(30)
  CTX   MAX_LENGTH                      VARCHAR2(50)
  CTX   CATEGORY                        VARCHAR2(10)
  CTX   SEVERITY                        VARCHAR2(10)
  CTX   FND_LOG_SEVERITY                VARCHAR2(50)
END FND_NEW_MESSAGES

# -- End Entity Definitions -- 


BEGIN FND_NEW_MESSAGES "DKA" "DKA_SPOWFDA_ERRORS_MAIL_CORPS"
  OWNER = "BDELATTR"
  LAST_UPDATE_DATE = "2016/05/18"
  MESSAGE_NUMBER = "*NULL*"
  MESSAGE_TEXT =
 "*** CECI EST UN EMAIL AUTOMATIQUE DE NOTIFICATION. NE PAS REPONDRE A SON EMETTEUR ***\n\
\n\
Bonjour,\n\
Votre demande d'achat &NUM_DA a été remise dans votre chariot d'achat avec le libellé : &DESCRIPTION.\n\
Si vous aviez soumis pour approbation cette demande d'achat merci de la re-soumettre afin de la transformer en commande.\n\
Helpdesk Dalkia\n\
Support Applicatif\n\
0825 0816 73\n\
managementap@dalkia.fr"
  DESCRIPTION = "*NULL*"
  TYPE = "30_PCT_EXPANSION_PROMPT"
  MAX_LENGTH = "*NULL*"
  CATEGORY = "*NULL*"
  SEVERITY = "*NULL*"
  FND_LOG_SEVERITY = "*NULL*"
END FND_NEW_MESSAGES

BEGIN FND_NEW_MESSAGES "DKA" "DKA_SPOWFDA_ERRORS_MAIL_SUJET"
  OWNER = "BDELATTR"
  LAST_UPDATE_DATE = "2016/05/18"
  MESSAGE_NUMBER = "*NULL*"
  MESSAGE_TEXT =
 "DALKIA Achats - DA &NUM_DA bloquée Secteur &APPART Description &DESCRIPTION"
  DESCRIPTION = "*NULL*"
  TYPE = "30_PCT_EXPANSION_PROMPT"
  MAX_LENGTH = "*NULL*"
  CATEGORY = "*NULL*"
  SEVERITY = "*NULL*"
  FND_LOG_SEVERITY = "*NULL*"
END FND_NEW_MESSAGES

