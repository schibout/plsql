# $Header$

# 
LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

#Source Database DT1OAP

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 


BEGIN DKA_PARAMETER "SPAAJUSTAR" "CURRENCY_CODE"
  DESCRIPTION = "Devise"
  TABLE_NAME = "FND_CURRENCIES"
  COLUMN_NAME = "CURRENCY_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "EUR"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPAAJUSTAR" "EXPENDITURE_CLASS_CODE"
  DESCRIPTION = "Code classe de dépense"
  TABLE_NAME = "PA_LOOKUPS"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "PU"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPAAJUSTAR" "EXPENDITURE_GROUP_STATUS_CODE"
  DESCRIPTION = "Statut de groupe de dépenses"
  TABLE_NAME = "PA_LOOKUPS"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "RELEASED"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPAAJUSTAR" "EXPENDITURE_STATUS_CODE"
  DESCRIPTION = "Statut des dépenses"
  TABLE_NAME = "PA_LOOKUPS"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "APPROVED"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPAAJUSTAR" "SYSTEM_LINKAGE_FUNCTION"
  DESCRIPTION = "Fonction de link ??"
  TABLE_NAME = "PA_SYSTEM_LINKAGES"
  COLUMN_NAME = "FUNCTION"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "PJ"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPAAJUSTAR" "TRANSACTION_SOURCE"
  DESCRIPTION = "Source des dépenses"
  TABLE_NAME = "PA_TRANSACTION_SOURCES"
  COLUMN_NAME = "TRANSACTION_SOURCE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "ORACLE AR"
END DKA_PARAMETER

