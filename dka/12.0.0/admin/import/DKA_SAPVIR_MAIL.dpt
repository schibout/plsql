# $Header:  $

LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions --

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions --


BEGIN DKA_PARAMETER "SAPVIR_MAIL" "SMTP_CONNECTION"
  DESCRIPTION = "Connection SMTP"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "smtp.dalkia.net"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SAPVIR_MAIL" "EXPEDITEUR_MAIL"
  DESCRIPTION = "Expediteur du mail automatique"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "no-reply@dalkia.fr"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SAPVIR_MAIL" "TYPE_PIECE_JOINTE"
  DESCRIPTION = "Format de la pièce jointe"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "application/pdf"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SAPVIR_MAIL" "TEST_EXP_MAIL"
  DESCRIPTION = "Expediteur du mail VIREMENT"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "mail_reply@dalkia.fr"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SAPVIR_MAIL" "TEST_DEST_MAIL"
  DESCRIPTION = "Destinataire du mail VIREMENT"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "mail_dest@dalkia.fr"
END DKA_PARAMETER