# $Header$

LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions --

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions --

BEGIN DKA_PARAMETER "DKA_IHREMP" "SOURCE_EMPLOYE"
  DESCRIPTION = "valeur SOURCE_EMPLOYE (valeur = KADOR) pour le traitement : DKA_IHREMP"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "KADOR"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_IHREMP" "SOURCE_CONTACT"
  DESCRIPTION = "valeur SOURCE_CONTACT (valeur = SESAME) pour le traitement : DKA_IHREMP"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "SESAME"
END DKA_PARAMETER
