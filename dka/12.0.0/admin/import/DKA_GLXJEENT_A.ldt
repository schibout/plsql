# dbdrv: exec fnd bin FNDLOAD bin &phase=daa+70 checkfile:~PROD:~PATH:~FILE &ui_apps 0 Y UPLOAD @FND:patch/115/import/affrmcus.lct @~PROD:~PATH/~FILE
LANGUAGE = "US"
LDRCONFIG = "affrmcus.lct 120.7.12020000.4"

#Source Database HELMAS

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE FND_FORM_CUSTOM_RULES
  KEY   ID                              VARCHAR2(50)
  BASE  FUNCTION_NAME                   VARCHAR2(30)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TRIGGER_EVENT                   VARCHAR2(30)
  BASE  TRIGGER_OBJECT                  VARCHAR2(100)
  BASE  CONDITION                       VARCHAR2(2000)
  BASE  SEQUENCE                        VARCHAR2(50)
  BASE  CREATED_BY                      VARCHAR2(50)
  BASE  CREATION_DATE                   VARCHAR2(11)
  BASE  OWNER                           VARCHAR2(4000)
  BASE  LAST_UPDATE_DATE                VARCHAR2(11)
  BASE  LAST_UPDATE_LOGIN               VARCHAR2(50)
  BASE  ENABLED                         VARCHAR2(1)
  BASE  FIRE_IN_ENTER_QUERY             VARCHAR2(1)
  BASE  RULE_KEY                        VARCHAR2(30)
  BASE  FORM_NAME                       VARCHAR2(30)
  BASE  RULE_TYPE                       VARCHAR2(1)

  DEFINE FND_FORM_CUSTOM_SCOPES
    KEY   RULE_ID                         VARCHAR2(50)
    KEY   LEVEL_ID                        VARCHAR2(50)
    KEY   LEVEL_VALUE                     VARCHAR2(4000)
    BASE  LEVEL_VALUE_APPLICATION_ID      VARCHAR2(50)
    BASE  LAST_UPDATE_DATE                VARCHAR2(11)
    BASE  OWNER                           VARCHAR2(4000)
    BASE  CREATION_DATE                   VARCHAR2(11)
    BASE  CREATED_BY                      VARCHAR2(50)
    BASE  LAST_UPDATE_LOGIN               VARCHAR2(50)
  END FND_FORM_CUSTOM_SCOPES

    DEFINE FND_FORM_CUSTOM_ACTIONS
      KEY   ACTION_ID                       VARCHAR2(50)
      BASE  SEQUENCE                        VARCHAR2(50)
      BASE  PROPERTY_VALUE                  VARCHAR2(4000)
      BASE  ARGUMENT_TYPE                   VARCHAR2(1)
      BASE  CREATED_BY                      VARCHAR2(50)
      BASE  CREATION_DATE                   VARCHAR2(11)
      BASE  OWNER                           VARCHAR2(4000)
      BASE  LAST_UPDATE_DATE                VARCHAR2(11)
      BASE  LAST_UPDATE_LOGIN               VARCHAR2(50)
      BASE  TARGET_OBJECT                   VARCHAR2(100)
      BASE  ACTION_TYPE                     VARCHAR2(1)
      BASE  ENABLED                         VARCHAR2(1)
      BASE  OBJECT_TYPE                     VARCHAR2(30)
      BASE  FOLDER_PROMPT_BLOCK             VARCHAR2(30)
      BASE  MESSAGE_TYPE                    VARCHAR2(1)
      BASE  MESSAGE_TEXT                    VARCHAR2(4000)
      BASE  SUMMARY                         VARCHAR2(255)
      BASE  BUILTIN_TYPE                    VARCHAR2(1)
      BASE  BUILTIN_ARGUMENTS               VARCHAR2(4000)
      BASE  LANGUAGE                        VARCHAR2(4)
      KEY   RULE_ID                         VARCHAR2(50)
      BASE  PROPERTY_NAME                   VARCHAR2(50)
      BASE  MENU_ENTRY                      VARCHAR2(30)
      BASE  MENU_LABEL                      VARCHAR2(80)
      BASE  MENU_SEPERATOR                  VARCHAR2(1)
      BASE  MENU_ENABLED_IN                 VARCHAR2(255)
      BASE  MENU_ACTION                     VARCHAR2(1)
      BASE  MENU_ARGUMENT_LONG              VARCHAR2(2000)
      BASE  MENU_ARGUMENT_SHORT             VARCHAR2(255)
      BASE  REQUEST_APPLICATION_ID          VARCHAR2(50)

      DEFINE FND_FORM_CUSTOM_PARAMS
        KEY   ACTION_ID                       VARCHAR2(50)
        KEY   NAME                            VARCHAR2(240)
        BASE  VALUE                           VARCHAR2(4000)
        BASE  SEQUENCE                        VARCHAR2(50)
        BASE  DEFAULT_TYPE                    VARCHAR2(1)
        BASE  INHERIT                         VARCHAR2(1)
        BASE  LAST_UPDATE_DATE                VARCHAR2(11)
        BASE  OWNER                           VARCHAR2(4000)
        BASE  CREATED_BY                      VARCHAR2(50)
        BASE  CREATION_DATE                   VARCHAR2(11)
        BASE  LAST_UPDATE_LOGIN               VARCHAR2(50)
      END FND_FORM_CUSTOM_PARAMS
    END FND_FORM_CUSTOM_ACTIONS
END FND_FORM_CUSTOM_RULES

# -- End Entity Definitions -- 


BEGIN FND_FORM_CUSTOM_RULES "473"
  FUNCTION_NAME = "GLXJEENT_A"
  DESCRIPTION = "DKA - Validation de la tache"
  TRIGGER_EVENT = "WHEN-VALIDATE-RECORD"
  TRIGGER_OBJECT = "LINES"
  CONDITION =
 "(select nvl(completion_date, sysdate+1000)\n\
  from pa_tasks\n\
  where task_id = :LINES.ATTRIBUTE17\n\
      and :LINES.CONTEXT3 in ( 'Y.R.X' , 'Y.E.X') ) < :HEADER.DEFAULT_EFFECTIVE_DATE"
  SEQUENCE = "2"
  CREATED_BY = "7644"
  CREATION_DATE = "2019/10/21"
  OWNER = "SELOUAHABI"
  LAST_UPDATE_DATE = "2020/07/01"
  LAST_UPDATE_LOGIN = "12482181"
  ENABLED = "Y"
  FIRE_IN_ENTER_QUERY = "Y"
  FORM_NAME = "GLXJEENT"
  RULE_TYPE = "A"

  BEGIN FND_FORM_CUSTOM_ACTIONS "747" "473"
    SEQUENCE = "1"
    ARGUMENT_TYPE = "C"
    CREATED_BY = "7644"
    CREATION_DATE = "2019/10/21"
    OWNER = "SELOUAHABI"
    LAST_UPDATE_DATE = "2019/10/23"
    LAST_UPDATE_LOGIN = "9730870"
    ACTION_TYPE = "M"
    ENABLED = "Y"
    OBJECT_TYPE = "ITEM"
    MESSAGE_TYPE = "E"
    MESSAGE_TEXT =
 "='La tache '||(select task_number\n\
  from pa_tasks\n\
  where task_id = :LINES.ATTRIBUTE17)||' n''est pas valide sur la ligne ' ||:LINES.JE_LINE_NUM"
    BUILTIN_TYPE = "C"
    LANGUAGE = "*"
    PROPERTY_NAME = "1550"
    MENU_SEPERATOR = "N"
  
  END FND_FORM_CUSTOM_ACTIONS
  

  BEGIN FND_FORM_CUSTOM_SCOPES "473" "20" ""
    LAST_UPDATE_DATE = "2019/10/21"
    OWNER = "SELOUAHABI"
    CREATION_DATE = "2019/10/21"
    CREATED_BY = "7644"
    LAST_UPDATE_LOGIN = "9730870"
  END FND_FORM_CUSTOM_SCOPES
  
END FND_FORM_CUSTOM_RULES

BEGIN FND_FORM_CUSTOM_RULES "230"
  FUNCTION_NAME = "GLXJEENT_A"
  DESCRIPTION = "DKA - Valorisation de la variable :WORLD.DEFAULT_BALANCING"
  TRIGGER_EVENT = "WHEN-VALIDATE-RECORD"
  TRIGGER_OBJECT = "HEADER"
  CONDITION = ":SYSTEM.RECORD_STATUS <> 'QUERY'"
  SEQUENCE = "1"
  CREATED_BY = "122"
  CREATION_DATE = "2016/12/20"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2016/12/20"
  LAST_UPDATE_LOGIN = "-1"
  ENABLED = "Y"
  FIRE_IN_ENTER_QUERY = "N"
  FORM_NAME = "GLXJEENT"
  RULE_TYPE = "F"

  BEGIN FND_FORM_CUSTOM_ACTIONS "345" "230"
    SEQUENCE = "1"
    PROPERTY_VALUE =
 "=(select  min(segment_value)\n\
from    gl_ledger_le_bsv_specific_v \n\
where   ledger_id = :HEADER.LEDGER_ID\n\
and     :HEADER.DEFAULT_EFFECTIVE_DATE between nvl(start_date, :HEADER.DEFAULT_EFFECTIVE_DATE - 1) and nvl(end_date, :HEADER.DEFAULT_EFFECTIVE_DATE + 1))"
    ARGUMENT_TYPE = "C"
    CREATED_BY = "122"
    CREATION_DATE = "2016/12/20"
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2016/12/20"
    LAST_UPDATE_LOGIN = "-1"
    TARGET_OBJECT = "WORLD.DEFAULT_BALANCING"
    ACTION_TYPE = "P"
    ENABLED = "Y"
    OBJECT_TYPE = "ITEM"
    MESSAGE_TYPE = "S"
    BUILTIN_TYPE = "C"
    LANGUAGE = "*"
    PROPERTY_NAME = "0"
    MENU_SEPERATOR = "N"
  
  END FND_FORM_CUSTOM_ACTIONS
  

  BEGIN FND_FORM_CUSTOM_SCOPES "230" "20" ""
    LAST_UPDATE_DATE = "2016/12/20"
    OWNER = "ORACLE12.2.4"
    CREATION_DATE = "2016/12/20"
    CREATED_BY = "122"
    LAST_UPDATE_LOGIN = "-1"
  END FND_FORM_CUSTOM_SCOPES
  
END FND_FORM_CUSTOM_RULES

