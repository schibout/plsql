# $Header$

# 
LANGUAGE = "US"
LDRCONFIG = "DKA_XX_TRANSCO.lct"

#Source Database HELMAS

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE DKA_STRANSCO_HEADERS
  KEY   SET_NAME                        VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(240)
  BASE  PARAM1_NAME                     VARCHAR2(30)
  BASE  PARAM1_LOV                      VARCHAR2(250)
  BASE  PARAM1_FLAG                     VARCHAR2(1)
  BASE  PARAM2_NAME                     VARCHAR2(30)
  BASE  PARAM2_LOV                      VARCHAR2(250)
  BASE  PARAM2_FLAG                     VARCHAR2(1)
  BASE  PARAM3_NAME                     VARCHAR2(30)
  BASE  PARAM3_LOV                      VARCHAR2(250)
  BASE  PARAM3_FLAG                     VARCHAR2(1)
  BASE  RETURN_VALUE_NAME               VARCHAR2(30)
  BASE  RETURN_VALUE_LOV                VARCHAR2(250)
  BASE  INACTIVE_DATE                   VARCHAR2(19)

  DEFINE DKA_STRANSCO_LINES
    KEY   SET_NAME                        VARCHAR2(50)
    KEY   PARAMS_VALUE                    VARCHAR2(90)
    BASE  PARAM1_VALUE                    VARCHAR2(30)
    BASE  PARAM2_VALUE                    VARCHAR2(30)
    BASE  PARAM3_VALUE                    VARCHAR2(30)
    BASE  RETURN_VALUE                    VARCHAR2(30)
    BASE  ENABLE                          VARCHAR2(1)
    BASE  INACTIVE_DATE                   VARCHAR2(19)
    BASE  START_DATE                      VARCHAR2(19)
    BASE  END_DATE                        VARCHAR2(19)
  END DKA_STRANSCO_LINES
END DKA_STRANSCO_HEADERS

# -- End Entity Definitions -- 


BEGIN DKA_STRANSCO_HEADERS "DKA_LOCAL_GROUPE_TYPE_EVENT"
  DESCRIPTION =
 "Comptes FA éligibles à l'alimentation du CUF projet/tâche/type d'événement dans GL"
  PARAM1_NAME = "Compte local"
  PARAM1_LOV =
 "select flex_value,substr(ffv.description,1,50) from fnd_flex_values_vl ffv, fnd_flex_value_sets ffvs where ffv.flex_value_set_id = ffvs.flex_value_set_id and ffvs.flex_value_set_name = 'DAOPCCF_LOCAL' and ffv.summary_flag = 'N'"
  PARAM1_FLAG = "Y"
  PARAM2_NAME = "Compte Groupe"
  PARAM2_LOV =
 "select flex_value,substr(ffv.description,1,50) from fnd_flex_values_vl ffv, fnd_flex_value_sets ffvs where ffv.flex_value_set_id = ffvs.flex_value_set_id and ffvs.flex_value_set_name = 'DAOPCCF_ANALYTIQUE' and ffv.summary_flag = 'N'"
  PARAM2_FLAG = "Y"
  PARAM3_NAME = "Type d'événement"
  PARAM3_LOV =
 "select  event_type, substr(description,1,50) from PA_EVENT_TYPES"
  PARAM3_FLAG = "Y"
  RETURN_VALUE_NAME = "Compte de lettrage"
  RETURN_VALUE_LOV =
 "select replace(lookup_code,'Y','O'), meaning from fnd_lookups where lookup_type = 'YES_NO'"

  BEGIN DKA_STRANSCO_LINES "DKA_LOCAL_GROUPE_TYPE_EVENT"
