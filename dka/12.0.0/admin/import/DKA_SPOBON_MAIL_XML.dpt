# $Header:  $

LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions --

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions --

BEGIN DKA_PARAMETER "SPOBON_MAIL" "TEST_EXP_MAIL"
  DESCRIPTION = "Expediteur du mail XML"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "mail_reply@dalkia.fr"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPOBON_MAIL" "TEST_DEST_MAIL"
  DESCRIPTION = "Destinataire du mail XML"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "mail_dest@dalkia.fr"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPOBON_MAIL" "MAIL_PLATEFORME"
  DESCRIPTION = "Adresse mail de la plateforme d'approvisionnement"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "plateformeappro@dalkia.fr"
END DKA_PARAMETER


