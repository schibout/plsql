  TABLE_NAME = "AP_LOOKUP_CODES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "PREPAYMENT"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SAPBLOCAGE" "STANDARD"
  DESCRIPTION = "Type de facture Standard"
  TABLE_NAME = "AP_LOOKUP_CODES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "STANDARD"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SAPBLOCAGE" "SOURCE"
  DESCRIPTION = "Source de la facture"
  TABLE_NAME = "AP_LOOKUP_CODES"
  COLUMN_NAME = "LOOKUP_CODE"
