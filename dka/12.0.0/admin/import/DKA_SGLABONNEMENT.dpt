# 
LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 


BEGIN DKA_PARAMETER "DKA_SGLABONNEMENT" "GL_AUTOPOST_SET_NAME"
  DESCRIPTION = "Nom du jeu de lot auto imputation dans GL"
  TABLE_NAME = "GL_AUTOMATIC_POSTING_SETS"
  COLUMN_NAME = "AUTOPOST_SET_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "DKA_ABONNEMENT" 
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SGLABONNEMENT" "GL_RESPONSIBILITY_KEY"
  DESCRIPTION = "Responsabilité de lancement des traitements GL"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "TOUT_GL_OPE_ADMINISTRATEUR"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SGLABONNEMENT" "ETATS_RESPONSIBILITY_KEY"
  DESCRIPTION = "Responsabilité de consultation des états"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "DKA_ETATS"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SGLABONNEMENT" "NOMBRE_COPIES"
  DESCRIPTION = "Nombre de copies à imprimer"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "NUMBER"
  NUMBER_VALUE = "0"
END DKA_PARAMETER
