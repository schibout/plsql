# $Header$

# dbdrv: exec fnd bin FNDLOAD bin &phase=daa+52 checkfile:~PROD:~PATH:~FILE &ui_apps 0 Y UPLOAD @FND:patch/115/import/afmdmsg.lct @~PROD:~PATH/~FILE
LANGUAGE = "F"
LDRCONFIG = "afmdmsg.lct 115.26"

#Source Database REF1HEL

# -- Begin Entity Definitions -- 

DEFINE FND_NEW_MESSAGES
  KEY   APPLICATION_SHORT_NAME          VARCHAR2(50)
  KEY   MESSAGE_NAME                    VARCHAR2(30)
  CTX   OWNER                           VARCHAR2(4000)
  BASE  LAST_UPDATE_DATE                VARCHAR2(10)
  CTX   MESSAGE_NUMBER                  VARCHAR2(50)
  TRANS MESSAGE_TEXT                    VARCHAR2(2000)
  CTX   DESCRIPTION                     VARCHAR2(240)
  CTX   TYPE                            VARCHAR2(30)
  CTX   MAX_LENGTH                      NUMBER(22)
  CTX   CATEGORY                        VARCHAR2(10)
  CTX   SEVERITY                        VARCHAR2(10)
  CTX   FND_LOG_SEVERITY                NUMBER(22)
END FND_NEW_MESSAGES

# -- End Entity Definitions -- 


BEGIN FND_NEW_MESSAGES "DKA" "DKA_SARG00C8_OBJET"
  OWNER = "USER"
  LAST_UPDATE_DATE = "2015/01/08"
  MESSAGE_TEXT =
 "Etat de comparaison mensuel des factures AR avec CI en date du &DATE_SYS"
  TYPE = "OTHER"
END FND_NEW_MESSAGES

BEGIN FND_NEW_MESSAGES "DKA" "DKA_SARG00C8_CORP"
  OWNER = "USER"
  LAST_UPDATE_DATE = "2015/01/08"
  MESSAGE_TEXT =
 "Bonjour,<br /><br />\n\
Veuillez trouver ci-joint le fichier de comparaison mensuel des factures AR avec CI.<br /><br />\n\
Cordialement.<br /><br />\n\
Merci de ne pas répondre à ce mail, veuillez vous adresser directement à votre interlocuteur."
  TYPE = "OTHER"
END FND_NEW_MESSAGES

