BEGIN DKA_PARAMETER "INTERFACE_TOOLS_EAI" "DEBUG_MODE"
  DESCRIPTION = "Valeur du Mode Debug (N/Y)"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Y"
END DKA_PARAMETER

