# $Header$

# 
LANGUAGE = "US"
LDRCONFIG = "DKA_XX_TRANSCO.lct"

#Source Database HELMAS

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE DKA_STRANSCO_HEADERS
  KEY   SET_NAME                        VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(240)
  BASE  PARAM1_NAME                     VARCHAR2(30)
  BASE  PARAM1_LOV                      VARCHAR2(250)
  BASE  PARAM1_FLAG                     VARCHAR2(1)
  BASE  PARAM2_NAME                     VARCHAR2(30)
  BASE  PARAM2_LOV                      VARCHAR2(250)
  BASE  PARAM2_FLAG                     VARCHAR2(1)
  BASE  PARAM3_NAME                     VARCHAR2(30)
  BASE  PARAM3_LOV                      VARCHAR2(250)
  BASE  PARAM3_FLAG                     VARCHAR2(1)
  BASE  RETURN_VALUE_NAME               VARCHAR2(30)
  BASE  RETURN_VALUE_LOV                VARCHAR2(250)
  BASE  INACTIVE_DATE                   VARCHAR2(19)

  DEFINE DKA_STRANSCO_LINES
    KEY   SET_NAME                        VARCHAR2(50)
    KEY   PARAMS_VALUE                    VARCHAR2(90)
    BASE  PARAM1_VALUE                    VARCHAR2(30)
    BASE  PARAM2_VALUE                    VARCHAR2(30)
    BASE  PARAM3_VALUE                    VARCHAR2(30)
    BASE  RETURN_VALUE                    VARCHAR2(30)
    BASE  ENABLE                          VARCHAR2(1)
    BASE  INACTIVE_DATE                   VARCHAR2(19)
    BASE  START_DATE                      VARCHAR2(19)
    BASE  END_DATE                        VARCHAR2(19)
  END DKA_STRANSCO_LINES
END DKA_STRANSCO_HEADERS

# -- End Entity Definitions -- 


BEGIN DKA_STRANSCO_HEADERS "DKA_AP_ASSET_LIAB_ACCOUNT"
  DESCRIPTION =
 "SLA AP - Définition du compte fournisseur Immo (404) en fonction du compte fournisseur (401)"
  PARAM1_NAME = "Compte Fournisseur"
  PARAM1_LOV =
 "select flex_value, ffv.description from fnd_flex_values_vl ffv, fnd_flex_value_sets ffvs where ffv.flex_value_set_id = ffvs.flex_value_set_id and ffvs.flex_value_set_name = 'DAOPCCF_LOCAL' and ffv.summary_flag = 'N' and ffv.flex_value like '401%'"
  PARAM1_FLAG = "Y"
  PARAM2_FLAG = "N"
  PARAM3_FLAG = "N"
  RETURN_VALUE_NAME = "Compte Fournisseur Immo"
  RETURN_VALUE_LOV =
 "select flex_value, ffv.description from fnd_flex_values_vl ffv, fnd_flex_value_sets ffvs where ffv.flex_value_set_id = ffvs.flex_value_set_id and ffvs.flex_value_set_name = 'DAOPCCF_LOCAL' and ffv.summary_flag = 'N' and ffv.flex_value like '404%'"

  BEGIN DKA_STRANSCO_LINES "DKA_AP_ASSET_LIAB_ACCOUNT" "401050"
    PARAM1_VALUE = "401050"
    RETURN_VALUE = "404501"
    ENABLE = "Y"
    START_DATE = "01/01/2000 00:00:00"
  END DKA_STRANSCO_LINES
  
  BEGIN DKA_STRANSCO_LINES "DKA_AP_ASSET_LIAB_ACCOUNT" "401100"
    PARAM1_VALUE = "401100"
    RETURN_VALUE = "404100"
    ENABLE = "Y"
    START_DATE = "01/01/2000 00:00:00"
  END DKA_STRANSCO_LINES
  
END DKA_STRANSCO_HEADERS

