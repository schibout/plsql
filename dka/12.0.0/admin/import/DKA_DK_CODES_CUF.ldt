BEGIN VALUE_SET "DKA_LISTE_EMPLOYE"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2016/04/29 00:00:00"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "15"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Liste des employés"


  BEGIN VSET_TABLE
    OWNER = "CTROCHU"
    LAST_UPDATE_DATE = "2017/02/09 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "PER"
    APPLICATION_TABLE_NAME = "PER_ALL_PEOPLE_F"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "EMPLOYEE_NUMBER"
    VALUE_COLUMN_TYPE = "C"
    VALUE_COLUMN_SIZE = "30"
    ID_COLUMN_NAME = "person_id"
    ID_COLUMN_TYPE = "C"
    ID_COLUMN_SIZE = "20"
    MEANING_COLUMN_NAME = "FULL_NAME"
    MEANING_COLUMN_TYPE = "C"
    MEANING_COLUMN_SIZE = "240"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "where nvl(effective_end_date,sysdate) >= sysdate\n\
and :$PROFILES$.PER_BUSINESS_GROUP_ID=\n\
PER_ALL_PEOPLE_F.BUSINESS_GROUP_ID\n\
order by employee_number"
  END VSET_TABLE
  





END VALUE_SET

