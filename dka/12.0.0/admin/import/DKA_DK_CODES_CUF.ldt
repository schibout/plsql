    MEANING_COLUMN_NAME = "DESCRIPTION"
    MEANING_COLUMN_TYPE = "V"
    MEANING_COLUMN_SIZE = "240"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "where lookup_type = 'SOURCE'\n\
  and lookup_code NOT IN ('XpenseXpress' , 'SelfService')\n\
  and trunc(sysdate) between nvl(start_date_active,sysdate -1 ) and nvl(inactive_date , sysdate + 1) \n\
  and enabled_flag = 'Y'\n\
  order by displayed_field"
  END VSET_TABLE
  





END VALUE_SET

