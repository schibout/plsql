    DESCRIPTION = "Clé d'élément pour l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "240"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ITEM_KEY"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_ITEM_TYPE"
