    DESCRIPTION = "Pile d'erreurs associée a l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "2000"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_STACK"
