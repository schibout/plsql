    SUBTYPE = "SEND"
    FORMAT = "2000"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_MESSAGE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_NAME"
