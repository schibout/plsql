BEGIN ACTIVITY "WFERROR" "DEFAULT_ERROR"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Processus d'erreur avec relance"
  DESCRIPTION = "Processus d'erreur avec relance"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "Y"

  BEGIN PROCESS_ACTIVITY "ABORTPROCESS"
    ACTIVITY_ITEM_TYPE = "WFERROR"
    ACTIVITY_NAME = "ABORTPROCESS"
    ICON_GEOMETRY = "144,48"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "END-ABORT"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;144,48:224,48:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "CHECKERRORACTIVE"
    ACTIVITY_ITEM_TYPE = "WFERROR"
    ACTIVITY_NAME = "CHECKERRORACTIVE"
    ICON_GEOMETRY = "-112,-176"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "F" "END-1"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-112,-176:32,-176:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "T" "DEFAULT_RESET_ERROR_NTF"
      ARROW_GEOMETRY = "0;0;2;1;0.014423;-112,-176:-144,-128:-112,-80:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "CHECKERRORACTIVE-1"
    ACTIVITY_ITEM_TYPE = "WFERROR"
    ACTIVITY_NAME = "CHECKERRORACTIVE"
    ICON_GEOMETRY = "16,-80"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "F" "END-2"
      ARROW_GEOMETRY = "0;0;2;0;0.570313;16,-80:96,-16:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "T" "RESET_ERROR"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;16,-80:144,-80:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "CHECKERRORACTIVE-2"
    ACTIVITY_ITEM_TYPE = "WFERROR"
    ACTIVITY_NAME = "CHECKERRORACTIVE"
    ICON_GEOMETRY = "16,48"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "F" "END-2"
      ARROW_GEOMETRY = "0;0;10;0;0.470000;16,48:96,-16:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "T" "ABORTPROCESS"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;16,48:144,48:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DEFAULT_RESET_ERROR_NTF"
    ACTIVITY_ITEM_TYPE = "WFERROR"
    ACTIVITY_NAME = "DEFAULT_RESET_ERROR_NTF"
    ICON_GEOMETRY = "-112,-80"
    VALUE_TYPE = "CONSTANT"
    PERFORM_ROLE = "SYSADMIN"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#TIMEOUT"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "TIMEOUT_VALUE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "ABORT" "CHECKERRORACTIVE-2"
      ARROW_GEOMETRY = "0;0;8;1;0.437500;-112,-80:-112,48:16,48:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "CLOSE" "END"
      ARROW_GEOMETRY = "0;0;8;1;0.139881;-112,-80:-112,112:224,112:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "RETRY" "CHECKERRORACTIVE-1"
      ARROW_GEOMETRY = "0;0;0;0;0.382813;-112,-80:16,-80:"
