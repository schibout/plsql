    SUBTYPE = "SEND"
    FORMAT = "30"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ASSIGNED_USER"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_ITEM_KEY"
