    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_NOTIF_ID"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_RESULT_CODE"
    DISPLAY_NAME = "Code résultat de l'erreur"
    DESCRIPTION = "Résultat de l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "30"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_RESULT_CODE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_STACK"
