BEGIN MESSAGE "WFERROR" "HR_SYSTEM_ERROR_MSG"
  PROTECT_LEVEL = "20"
  CUSTOM_LEVEL = "20"
  DISPLAY_NAME = "HR SYSTEM ERROR MSG"
  DESCRIPTION = "Message d'erreur utilisé pour les erreurs systeme."
  SUBJECT = "Erreur systeme dans le workflow. Type d'élément de l'erreur : &ER\
ROR_ITEM_TYPE. Clé de l'élément : &ERROR_ITEM_KEY."
  BODY = "DETAILS DE L'ELEMENT :\n\
Type d'élément = &ERROR_ITEM_TYPE\n\
Clé de l'élément = &ERROR_ITEM_KEY\n\
\n\
DETAILS DE L'ERREUR :\n\
Code erreur = &ERROR_NAME\n\
Message d'erreur = &ERROR_MESSAGE\n\
Pile d'erreurs = &ERROR_STACK\n\
\n\
DETAILS DU PROCESSUS :\n\
ID activité = &ERROR_ACTIVITY_ID\n\
Code de résultat = &ERROR_RESULT_CODE\n\
ID Notif = &ERROR_NOTIF_ID\n\
Utilisateur affecté = &ERROR_ASSIGNED_USER\n\
\n\
Choisissez l'une des options suivantes :\n\
\n\
Annuler\n\
\n\
Si vous n'etes pas parvenu(e) a corriger l'erreur, l'option Annuler arrete le \
processus a l'emplacement de l'erreur et provoque une restauration. Une notifi\
cation est envoyée a l'utilisateur pour lui signifier que les modifications so\
nt perdues et doivent etre effectuées a nouveau.\n\
\n\
Relancer\n\
\n\
Si vous avez résolu l'erreur, l'option Relancer permet de relancer le processu\
s.\n\
\n\
Si celui-ci aboutit, une Notif est envoyé pour signaler a l'utilisateur que se\
s modifications ont bien été effectuées. Le processus s'affiche alors dans la \
liste \"travail en cours\" de l'utilisateur pour l'inviter a continuer."
  DEFAULT_PRIORITY = "50"

  BEGIN MESSAGE_ATTRIBUTE "ERROR_ACTIVITY_ID"
    DISPLAY_NAME = "ID activité sur erreur"
    DESCRIPTION = "ID activité associé a l'activité sur erreur"
    TYPE = "NUMBER"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ACTIVITY_ID"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_ASSIGNED_USER"
    DISPLAY_NAME = "Utilisateur affecté a l'erreur"
    DESCRIPTION = "Rôle affecté a l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "30"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ASSIGNED_USER"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_ITEM_KEY"
    DISPLAY_NAME = "Clé d'élément de l'erreur"
    DESCRIPTION = "Clé d'élément pour l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "240"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ITEM_KEY"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_ITEM_TYPE"
    DISPLAY_NAME = "Type d'élément de l'erreur"
    DESCRIPTION = "Type d'élément de l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "8"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ITEM_TYPE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_MESSAGE"
    DISPLAY_NAME = "Message d'erreur"
    DESCRIPTION = "Message d'erreur déclenché par l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "2000"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_MESSAGE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_NAME"
    DISPLAY_NAME = "Code erreur"
    DESCRIPTION = "Code erreur produit par l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "30"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_NAME"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_NOTIF_ID"
    DISPLAY_NAME = "ID Notif de l'erreur"
    DESCRIPTION = "ID Notif de l'activité sur erreur"
    TYPE = "NUMBER"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_NOTIF_ID"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_RESULT_CODE"
    DISPLAY_NAME = "Code résultat de l'erreur"
    DESCRIPTION = "Résultat de l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "30"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_RESULT_CODE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_STACK"
