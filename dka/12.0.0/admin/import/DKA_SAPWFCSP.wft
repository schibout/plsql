BEGIN MESSAGE "DKA_CSP" "DKA_MSG_ACH_ANO_PRICE_LITIG"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Mess vers Acheteur Anomalie pour écart prix"
  SUBJECT = "&NIEME_RELANCE  &SOCIETE_FACTURE &TXT_ABC_OU_SBC &LIB_TITRE_FACT_\
NUM &DKA_NUM_FACT :    &DKA_MSG_CSP_ECART_PRX_OBJECT"
  BODY = "&DKA_MSG_CSP_ECART_PRIX_BODY"
  HTML_BODY = "<p align=center><font color=#003366 size=+2><b>&NIEME_RELANCE &\
DKA_MSG_CSP_ECART_PRX_OBJECT</font></b></p>\n\
<br />\n\
<br />\n\
&DOC_BLOCAGES\n\
<br />\n\
<br />\n\
<br />\n\
&DKA_MSG_CSP_ECART_PRIX_BODY\n\
<br />\n\
<br />\n\
Visu de l'image de la facture : &DKA_IMAGE_FACT<br />\n\
Visu de l'image de la commande : &DKA_IMAGE_CDE\n\
<br />\n\
<br />\n\
&DOC_LIGNE_ECART_PRIX\n\
<br />\n\
<br />\n\
<center>&LIB_HISTO_ACTIONS</center><br />\n\
&DOC_HISTO_ACTIONS\n\
<br />\n\
<br />\n\
<font &L_FONT_LITIGE_STYLE>&TEXTE_LITIGE</font>\n\
<br />\n\
<br />"
  DEFAULT_PRIORITY = "50"

  BEGIN MESSAGE_ATTRIBUTE "RESULT"
    DISPLAY_NAME = "REPONSE"
    FORMAT = "DKA : SOUMETTRE"
    VALUE_TYPE = "CONSTANT"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "FORWARD_TO_USERNAME_RESPONSE"
    DISPLAY_NAME = "Retransmettre a"
    TYPE = "ROLE"
    SUBTYPE = "RESPOND"
    VALUE_TYPE = "CONSTANT"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DKA_EMPLOYE_FWD"
    DISPLAY_NAME = "employé a qui on va transferer"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "VALIDEUR_BAP"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DOC_HISTO_ACTIONS"
    DISPLAY_NAME = "historiques des actions"
    TYPE = "DOCUMENT"
    SUBTYPE = "SEND"
    FORMAT = "_self"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "DOC_HISTO"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DOC_BLOCAGES"
    DISPLAY_NAME = "blocages"
    TYPE = "DOCUMENT"
    SUBTYPE = "SEND"
    FORMAT = "_self"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "DOC_BLOCAGES"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DKA_G_W_ITEMATTR_REPONSE"
    DISPLAY_NAME = "nom du global item attribute ou sera stocke la reponse"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "RE_NOTIF_ACH_ANO_ECART_PRIX"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "LIB_HISTO_ACTIONS"
    DISPLAY_NAME = "libellé historique des actions présent dans les notifs"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "LIB_HISTO_ACTIONS"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DKA_COMMENTS"
    DISPLAY_NAME = "Commentaire obligatoire"
    TYPE = "VARCHAR2"
    SUBTYPE = "RESPOND"
    FORMAT = "200"
    VALUE_TYPE = "CONSTANT"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HIDE_MOREINFO"
    DISPLAY_NAME = "#HIDE_MOREINFO"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "Y"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "NIEME_RELANCE"
