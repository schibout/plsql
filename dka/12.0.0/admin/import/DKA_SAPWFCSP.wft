BEGIN ACTIVITY "DKA_CSP" "DKA_PROCESS_AP"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Processus de démarrage pour les factures venant de AP"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "Y"

  BEGIN PROCESS_ACTIVITY "ABORTPROCESS"
    ACTIVITY_ITEM_TYPE = "WFERROR"
    ACTIVITY_NAME = "ABORTPROCESS"
    START_END = "END"
    ICON_GEOMETRY = "-176,-288"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "END"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "END"
    START_END = "END"
    ICON_GEOMETRY = "288,-128"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "START"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "START"
    START_END = "START"
    ICON_GEOMETRY = "-304,-128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "DKA_INIT_WF_AP"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-304,-128:-176,-128:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_ANOMALIE_AP"
    ACTIVITY_ITEM_TYPE = "DKA_CSP"
    ACTIVITY_NAME = "DKA_ANOMALIE_AP"
    ICON_GEOMETRY = "192,-128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "END"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;192,-128:288,-128:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_DUPLIQUE_BLOCAGE_AP_OI"
    ACTIVITY_ITEM_TYPE = "DKA_CSP"
    ACTIVITY_NAME = "DKA_DUPLIQUE_BLOCAGE_AP_OI"
    ICON_GEOMETRY = "32,-128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "DKA_ANOMALIE_AP"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;32,-128:192,-128:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_INIT_WF_AP"
    ACTIVITY_ITEM_TYPE = "DKA_CSP"
    ACTIVITY_NAME = "DKA_INIT_WF_AP"
    ICON_GEOMETRY = "-176,-128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "FAIL" "ABORTPROCESS"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-176,-128:-176,-288:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "SUCCESS" "DKA_DUPLIQUE_BLOCAGE_AP_OI"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-176,-128:32,-128:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY
END ACTIVITY

