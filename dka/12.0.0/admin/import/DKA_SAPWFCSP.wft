    DESCRIPTION = "Type d'élément de l'activité sur erreur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "8"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "ERROR_ITEM_TYPE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "ERROR_MESSAGE"
    DISPLAY_NAME = "Message d'erreur"
    DESCRIPTION = "Message d'erreur déclenché par l'activité sur erreur"
