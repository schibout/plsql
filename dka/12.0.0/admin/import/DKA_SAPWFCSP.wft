  BEGIN PROCESS_ACTIVITY "DKA_FACT_BLOQ_OI"
    ACTIVITY_ITEM_TYPE = "DKA_CSP"
    ACTIVITY_NAME = "DKA_FACT_BLOQ_OI"
    ICON_GEOMETRY = "0,-256"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "END-1"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;0,-256:192,-256:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_FACT_TRAITEE_OI"
    ACTIVITY_ITEM_TYPE = "DKA_CSP"
    ACTIVITY_NAME = "DKA_FACT_TRAITEE_OI"
    ICON_GEOMETRY = "-176,-128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "N" "DKA_FACT_BLOQ_OI"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-176,-128:0,-256:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "Y" "END"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-176,-128:-16,-128:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_INIT_WF_OI"
    ACTIVITY_ITEM_TYPE = "DKA_CSP"
    ACTIVITY_NAME = "DKA_INIT_WF_OI"
    ICON_GEOMETRY = "-336,-128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "FAIL" "ABORTPROCESS"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-336,-128:-336,-288:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "SUCCESS" "DKA_FACT_TRAITEE_OI"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-336,-128:-176,-128:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY
END ACTIVITY

