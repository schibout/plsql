-- Doc. associée    :
-- Commentaires     : À exécuter sous SQLPLUS avec l'utilisateur DKA en 
--                    passant en paramètres
--                    1- Password APPS
--                    2- Password DKA
--                    3- Tablespace des données pour le schéma DKA                              
--------------------------------------------------------------------------------------------              
-- HISTORIQUE DES MODIFICATIONS                                                                           
-- Date       Qui Description                                                                             
-- ---------- --- -------------------------------------------------------------------------               
--------------------------------------------------------------------------------------------              

CONNECT &&1/&&2

--PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--PROMPT DROP DE LA SEQUENCE DKA_SAPFRS_MAJ_SITES_HIST_S
--PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP SEQUENCE DKA_SAPFRS_MAJ_SITES_HIST_S;


CREATE SEQUENCE DKA_SAPFRS_MAJ_SITES_HIST_S INCREMENT BY 1
START WITH 1;       
GRANT ALL ON dka.DKA_SAPFRS_MAJ_SITES_HIST_S  TO apps WITH GRANT OPTION;


EXIT;