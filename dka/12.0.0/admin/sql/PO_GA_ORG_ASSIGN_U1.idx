drop  index PO.PO_GA_ORG_ASSIGN_U1;

create unique index PO.PO_GA_ORG_ASSIGN_U1 on PO.PO_GA_ORG_ASSIGNMENTS (PO_HEADER_ID, ORGANIZATION_ID, VENDOR_SITE_ID)
  tablespace APPS_TS_TX_IDX
  pctfree 10
  initrans 11
  maxtrans 255
  storage
  (
    initial 128K
    next 128K
    minextents 1
    maxextents unlimited
    pctincrease 0
  );
  
drop  index PO.PO_GA_ORG_ASSIGN_ARC_U1;

create unique index PO.PO_GA_ORG_ASSIGN_ARC_U1 on PO.PO_GA_ORG_ASSIGNMENTS_ARCHIVE (PO_HEADER_ID, ORGANIZATION_ID, VENDOR_SITE_ID, REVISION_NUM)
  tablespace APPS_TS_TX_IDX
  pctfree 10
  initrans 11
  maxtrans 255
  storage
  (
    initial 128K
    next 128K
    minextents 1
    maxextents unlimited
    pctincrease 0
  );
  
EXIT;