-- 	Version: 1.0.0.0
--	Entree :
--              - Parametres   &1 : Username pour la creation de la sequence
--                             &2 : Password pour la creation de la sequence
--                             &3 : Username pour affectation des droits et creation des synonymes
--                             &4 : Password pour creation des synonymes
--		- Fichiers
--		- Tables
--      Sortie :
--	 	- Parametres
--		- Fichiers
--		- Tables
--------------------------------------------------
--- HISTORIQUE DES MODIFICATIONS
--- Date       Qui Description
--- ---------- --- --------------------------------------------------------------------------------------------
--- 2016/07/05 JJA Portage Helios R12
--------------------------------------------------
WHENEVER SQLERROR CONTINUE
CONNECT &&1/&&2

create sequence DKA_SAPWFCSP_S;

PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++             
PROMPT CREATION DES GRANTS                                                                                
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

GRANT ALL ON DKA_SAPWFCSP_S TO &&3;

PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++             
PROMPT DROP DES SYNONYMES                                                                                
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CONNECT &&3/&&4                                                                                          

PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++             
PROMPT CREATE DES SYNONYMES                                                                                
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

CREATE SYNONYM DKA_SAPWFCSP_S FOR &&1..DKA_SAPWFCSP_S;

EXIT;
