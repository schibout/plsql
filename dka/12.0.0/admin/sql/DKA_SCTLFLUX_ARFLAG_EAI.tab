--------------------------------------------------------------------------------
-- $$
-- Capgemini
-- Projet           : Contrôle de flux OA
-- Nom              : DKA_SCTLFLUX_ARFLAG_EAI.tab
-- Description      : Script de création de la table d'interface 
--                    DKA_SCTLFLUX_ARFLAG_EAI
-- Auteur           : J.JARDEZ (Capgemini)
-- Date de création : 15/10/2015
-- Doc. associée    :
-- Commentaires     : À exécuter sous SQLPLUS avec l'utilisateur DKA en 
--                    passant en paramètres
--                    1- Password APPS
--                    2- Password DKA
--                    3- Tablespace des données pour le schéma EAI
--------------------------------------------------------------------------------
-- Historique
-- Date       Qui Description
-- 30/05/2017 RBE EDB073 - Modification taille FIC_IDENT
-- ---------- --- --------------------------------------------------------------


CONNECT DKA/&2

PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT DROP DE LA TABLE DKA_SCTLFLUX_ARFLAG_EAI
PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE DKA_SCTLFLUX_ARFLAG_EAI CASCADE CONSTRAINTS;

PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT CREATION DE LA TABLE DKA_SCTLFLUX_ARFLAG_EAI
PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE TABLE DKA_SCTLFLUX_ARFLAG_EAI
(
  ORIGIN                        VARCHAR2(15),
  COMPANY_CODE                  VARCHAR2(4),
  INVOICE_NUMBER                VARCHAR2(8),
  FIC_IDENT                     VARCHAR2(150), -- RBE EDB073
  REQUEST_ID                    NUMBER,
  CREATED_BY                    NUMBER,
  CREATION_DATE                 DATE
)
TABLESPACE &3;

PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT CREATION DES GRANTS
PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
GRANT ALL ON DKA_SCTLFLUX_ARFLAG_EAI TO APPS WITH GRANT OPTION;

PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT CREATION DU SYNONYME
PROMPT +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CONNECT APPS/&1

DROP SYNONYM DKA_SCTLFLUX_ARFLAG_EAI;

CREATE SYNONYM DKA_SCTLFLUX_ARFLAG_EAI FOR DKA.DKA_SCTLFLUX_ARFLAG_EAI;

SHOW ERRORS
EXIT;

