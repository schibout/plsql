  BEGIN XLA_SEG_RULES "C" "DKA_FA_NBV_RETIRED_GAIN_GP_SEG"
    FLEXFIELD_ASSIGN_MODE_CODE = "S"
    FLEXFIELD_SEGMENT_CODE = "XARGOS_ACCOUNT"
    ENABLED_FLAG = "Y"
    VERSION_NUM = "1"
    OWNER = "NBOUSSEK"
    LAST_UPDATE_DATE = "2019/04/19"
    NAME =
 "DKA Livre d'amt - VCN ou DOT - Segment de groupe de plus-value de cession"
    DESCRIPTION =
 "DKA Livre d'amt - VCN ou DOT si CEE, CEEI12, DRC, DRCI12, SUB, SUBI4, SUBI12 pr segment groupe"
  
    BEGIN XLA_SEG_RULE_DETAILS "10"
      VALUE_TYPE_CODE = "S"
      VALUE_SOURCE_APP_SHORT_NAME = "OFA"
      VALUE_SOURCE_TYPE_CODE = "D"
      VALUE_SOURCE_CODE = "DKA_FA_DEPRN_GRP_ACCT"
      VALUE_CONSTANT = "DKA - Dotation aux amortissements - Groupe SOCIAL"
      OWNER = "LNAYROLL"
      LAST_UPDATE_DATE = "2019/04/03"
    
      BEGIN XLA_ADR_CONDITIONS "5"
        VALUE_TYPE_CODE = "C"
        SOURCE_APP_SHORT_NAME = "OFA"
        SOURCE_TYPE_CODE = "D"
        SOURCE_CODE = "DKA_FA_IS_TAX_BOOK"
        VALUE_CONSTANT = "N"
        LINE_OPERATOR_CODE = "E"
        LOGICAL_OPERATOR_CODE = "A"
        OWNER = "LNAYROLL"
        LAST_UPDATE_DATE = "2019/04/06"
      END XLA_ADR_CONDITIONS
      
      BEGIN XLA_ADR_CONDITIONS "10"
        BRACKET_LEFT_CODE = "("
