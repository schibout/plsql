BEGIN ACTIVITY "DKASDNOT" "DKA_SEND_NOTIF_PROCESS"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "DKA_SEND_NOTIF_PROCESS"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "N"

  BEGIN PROCESS_ACTIVITY "START"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "START"
    START_END = "START"
    ICON_GEOMETRY = "-128,0"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "DKA_NOTIFICATION"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-128,0:0,0:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "END"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "END"
    START_END = "END"
    ICON_GEOMETRY = "128,0"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_NOTIFICATION"
    ACTIVITY_ITEM_TYPE = "DKASDNOT"
    ACTIVITY_NAME = "DKA_NOTIFICATION"
    ICON_GEOMETRY = "0,0"
    VALUE_TYPE = "ITEMATTR"
    PERFORM_ROLE = "DKA_DESTINATAIRE"

    BEGIN ACTIVITY_TRANSITION "*" "END"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;0,0:128,0:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY
END ACTIVITY

