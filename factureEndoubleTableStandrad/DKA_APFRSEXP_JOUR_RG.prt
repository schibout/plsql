BEGIN LOOKUP_TYPE "HR_APPLICANT_STATUS"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Statut du candidat"
  DESCRIPTION = "Statut du candidat à la fin du traitement de génération des l\
ettres d'offre"
  ITEM_TYPE = "WFSTD"

  BEGIN LOOKUP_CODE "ACCEPTED"
    MEANING = "Accepté"
    DESCRIPTION = "L'offre est acceptée par le candidat"
  END LOOKUP_CODE

  BEGIN LOOKUP_CODE "NOTACCEPTED"
    MEANING = "Décliné"
    DESCRIPTION = "Le candidat n'accepte pas l'offre"
  END LOOKUP_CODE

  BEGIN LOOKUP_CODE "REJECTED"
    MEANING = "Rejeté"
    DESCRIPTION = "En un point donné du cycle d'approbation, il a été décidé d\
e rejeter le candidat"
  END LOOKUP_CODE
END LOOKUP_TYPE

