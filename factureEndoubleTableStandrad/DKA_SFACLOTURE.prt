# $Header: $


LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 


BEGIN DKA_PARAMETER "SPOCLOSCOM" "MESSAGE_PROJET_FERME"
  DESCRIPTION = "Message utilisé pour la fermeture des lignes de commandes sur projet fermé"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "FERMETURE PAR SCRIPT : LIGNE DE COMMANDE SUR PROJET FERME"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPOCLOSCOM" "MESSAGE_COMMANDE_ANCIENNE"
  DESCRIPTION = "Message utilisé pour la fermeture des lignes de commandes anciennes"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "FERMETURE PAR SCRIPT : LIGNE DE COMMANDE ANTERIEURE AU"
END DKA_PARAMETER


