# $Header$

# dbdrv: exec fnd bin FNDLOAD bin &phase=daa+64 checkfile:~PROD:~PATH:~FILE &ui_apps 0 Y UPLOAD @FND:patch/115/import/afcprset.lct @~PROD:~PATH/~FILE
LANGUAGE = "F"
LDRCONFIG = "afcprset.lct 120.3.12020000.2"

#Source Database HELDEV

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE REQ_SET_LINKS
  KEY   APPLICATION_SHORT_NAME          VARCHAR2(50)
  KEY   REQUEST_SET_NAME                VARCHAR2(30)
  BASE  RSET                            REFERENCES REQ_SET
  CTX   OWNER                           VARCHAR2(4000)
  BASE  START_STAGE_NAME                VARCHAR2(30)
  BASE  LAST_UPDATE_DATE                VARCHAR2(10)

  DEFINE STAGE_LINKS
    KEY   STAGE_NAME                      VARCHAR2(30)
    CTX   OWNER                           VARCHAR2(4000)
    BASE  SUCCESS_LINK                    VARCHAR2(30)
    BASE  WARNING_LINK                    VARCHAR2(30)
    BASE  ERROR_LINK                      VARCHAR2(30)
    BASE  LAST_UPDATE_DATE                VARCHAR2(10)
  END STAGE_LINKS
END REQ_SET_LINKS

DEFINE REQ_SET
  KEY   APPLICATION_SHORT_NAME          VARCHAR2(50)
  KEY   REQUEST_SET_NAME                VARCHAR2(30)
  CTX   OWNER                           VARCHAR2(4000)
  BASE  ALLOW_CONSTRAINTS_FLAG          VARCHAR2(1)
  BASE  PRINT_TOGETHER_FLAG             VARCHAR2(1)
  BASE  START_DATE_ACTIVE               VARCHAR2(11)
  BASE  START_STAGE_NAME                VARCHAR2(30)
  BASE  END_DATE_ACTIVE                 VARCHAR2(11)
  BASE  CONCURRENT_PROGRAM_NAME         VARCHAR2(30)
  BASE  OWNER_USER_NAME                 VARCHAR2(100)
  BASE  PRINTER                         VARCHAR2(30)
  BASE  PRINT_STYLE                     VARCHAR2(30)
  BASE  RECALC_PARAMETERS               VARCHAR2(1)
  TRANS USER_REQUEST_SET_NAME           VARCHAR2(240)
  TRANS DESCRIPTION                     VARCHAR2(240)
  BASE  LAST_UPDATE_DATE                VARCHAR2(10)

  DEFINE STAGE
    KEY   STAGE_NAME                      VARCHAR2(30)
    CTX   OWNER                           VARCHAR2(4000)
    BASE  CRITICAL                        VARCHAR2(1)
    BASE  OUTCOME                         VARCHAR2(1)
    BASE  ALLOW_CONSTRAINTS_FLAG          VARCHAR2(1)
    BASE  DISPLAY_SEQUENCE                VARCHAR2(50)
    BASE  FUNCTION_APPLICATION            VARCHAR2(50)
    BASE  FUNCTION                        VARCHAR2(30)
    BASE  SUCCESS_LINK                    VARCHAR2(30)
    BASE  WARNING_LINK                    VARCHAR2(30)
    BASE  ERROR_LINK                      VARCHAR2(30)
    BASE  CONCURRENT_PROGRAM_NAME         VARCHAR2(30)
    TRANS USER_STAGE_NAME                 VARCHAR2(240)
    TRANS DESCRIPTION                     VARCHAR2(240)
    BASE  LAST_UPDATE_DATE                VARCHAR2(10)

    DEFINE STAGE_PROG
      KEY   SEQUENCE                        VARCHAR2(50)
      CTX   OWNER                           VARCHAR2(4000)
      BASE  PROGRAM_APPLICATION             VARCHAR2(50)
      BASE  PROGRAM_NAME                    VARCHAR2(30)
      BASE  NLS_LANGUAGE                    VARCHAR2(30)
      BASE  NLS_TERRITORY                   VARCHAR2(30)
      BASE  CRITICAL                        VARCHAR2(1)
      BASE  NUMBER_OF_COPIES                VARCHAR2(50)
      BASE  PRINTER                         VARCHAR2(30)
      BASE  PRINT_STYLE                     VARCHAR2(30)
      BASE  SAVE_OUTPUT_FLAG                VARCHAR2(1)
      BASE  LAST_UPDATE_DATE                VARCHAR2(10)

      DEFINE PROG_ARGS
        KEY   DESC_FLEX_APPL                  VARCHAR2(50)
        KEY   DESC_FLEX_NAME                  VARCHAR2(50)
        KEY   COL_NAME                        VARCHAR2(30)
        CTX   OWNER                           VARCHAR2(4000)
        BASE  DISPLAY_FLAG                    VARCHAR2(1)
        BASE  INSERT_FLAG                     VARCHAR2(1)
        BASE  UPDATE_FLAG                     VARCHAR2(1)
        BASE  DEFAULT_TYPE                    VARCHAR2(1)
        BASE  DEFAULT_VALUE                   VARCHAR2(2000)
        BASE  SHARED_PARAMETER_NAME           VARCHAR2(30)
        BASE  LAST_UPDATE_DATE                VARCHAR2(10)
      END PROG_ARGS
    END STAGE_PROG
  END STAGE
END REQ_SET

# -- End Entity Definitions -- 


BEGIN REQ_SET "DKA" "DKA_SARREFAC_NON_OA_AR_INV_ORI"
  OWNER = "JJARDEZ"
  ALLOW_CONSTRAINTS_FLAG = "Y"
  PRINT_TOGETHER_FLAG = "Y"
  START_DATE_ACTIVE = "2016/11/02"
  START_STAGE_NAME = "STAGE01"
  CONCURRENT_PROGRAM_NAME = "DKA_SARREFAC_NON_OA_AR_INV_ORI"
  RECALC_PARAMETERS = "N"
  USER_REQUEST_SET_NAME =
 "DKA : Impression des orig de factures et annexes de Refac non OA (Trait. auto)"
  DESCRIPTION =
 "Impression des orig de factures et annexes de Refac non OA (Trait. auto)"
  LAST_UPDATE_DATE = "2016/11/02"

  BEGIN STAGE "STAGE01"
    OWNER = "JJARDEZ"
    CRITICAL = "N"
    OUTCOME = "C"
    ALLOW_CONSTRAINTS_FLAG = "N"
    DISPLAY_SEQUENCE = "100"
    FUNCTION_APPLICATION = "FND"
    FUNCTION = "FNDRSSTE"
    SUCCESS_LINK = "STAGE04"
    WARNING_LINK = "STAGE04"
    USER_STAGE_NAME = "Impression de l'original de facture"
    DESCRIPTION = "Impression de l'original de facture"
    LAST_UPDATE_DATE = "2016/11/02"
  
    BEGIN STAGE_PROG "110"
      OWNER = "JJARDEZ"
      PROGRAM_APPLICATION = "DKA"
      PROGRAM_NAME = "DKA_SARREFAC_INVOICE"
      CRITICAL = "Y"
      NUMBER_OF_COPIES = "0"
      PRINT_STYLE = "DKAPORTRAIT"
      SAVE_OUTPUT_FLAG = "Y"
      LAST_UPDATE_DATE = "2016/11/02"
    
      BEGIN PROG_ARGS "DKA" "$SRS$.DKA_SARREFAC_INVOICE" "ATTRIBUTE1"
        OWNER = "JJARDEZ"
        DISPLAY_FLAG = "Y"
        INSERT_FLAG = "Y"
        UPDATE_FLAG = "Y"
        DEFAULT_TYPE = "S"
        DEFAULT_VALUE =
 "select meaning from ar_lookups where lookup_type = 'SRS_RAXINV_ORDER_BY' and lookup_code = 'TRX_NUMBER'"
        LAST_UPDATE_DATE = "2016/11/02"
      END PROG_ARGS
      
    END STAGE_PROG
    
  END STAGE
  
  BEGIN STAGE "STAGE04"
    OWNER = "JJARDEZ"
    CRITICAL = "N"
    OUTCOME = "C"
    ALLOW_CONSTRAINTS_FLAG = "N"
    DISPLAY_SEQUENCE = "400"
    FUNCTION_APPLICATION = "FND"
    FUNCTION = "FNDRSSTE"
    USER_STAGE_NAME = "Impression des annexes de facture"
    DESCRIPTION = "Impression des annexes de facture"
    LAST_UPDATE_DATE = "2016/11/02"
  
    BEGIN STAGE_PROG "410"
      OWNER = "JJARDEZ"
      PROGRAM_APPLICATION = "DKA"
      PROGRAM_NAME = "DKA_SARREFAC_NON_OA_APPENDIX"
      CRITICAL = "Y"
      NUMBER_OF_COPIES = "0"
      PRINT_STYLE = "DKALANDSCAPE"
      SAVE_OUTPUT_FLAG = "Y"
      LAST_UPDATE_DATE = "2016/11/02"
    
    END STAGE_PROG
    
  END STAGE
  
END REQ_SET

BEGIN REQ_SET_LINKS "DKA" "DKA_SARREFAC_NON_OA_AR_INV_ORI"
  RSET = "DKA" "DKA_SARREFAC_NON_OA_AR_INV_ORI"
  OWNER = "JJARDEZ"
  START_STAGE_NAME = "STAGE01"
  LAST_UPDATE_DATE = "2016/11/02"

  BEGIN STAGE_LINKS "STAGE01"
    OWNER = "JJARDEZ"
    SUCCESS_LINK = "STAGE04"
    WARNING_LINK = "STAGE04"
    LAST_UPDATE_DATE = "2016/11/02"
  END STAGE_LINKS
  
  BEGIN STAGE_LINKS "STAGE04"
    OWNER = "JJARDEZ"
    LAST_UPDATE_DATE = "2016/11/02"
  END STAGE_LINKS
  
END REQ_SET_LINKS

