# $Header$

# 
LANGUAGE = "F"
LDRCONFIG = "DKA_XX_PARAM.lct"

#Source Database HELDEV

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(100)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 


BEGIN DKA_PARAMETER "SARAUTOEFFRGT" "EFFET_DUE_DATE_H"
  DESCRIPTION = "Coeff date d'exigibilité max"
  DATA_TYPE = "NUMBER"
  NUMBER_VALUE = "8"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARAUTOEFFRGT" "EFFET_DUE_DATE_L"
  DESCRIPTION = "Date d'exigibilité min"
  DATA_TYPE = "DATE"
  DATE_VALUE = "28/02/2009 00:00:00"
END DKA_PARAMETER

