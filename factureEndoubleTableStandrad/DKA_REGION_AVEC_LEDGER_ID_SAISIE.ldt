BEGIN DKA_PARAMETER "ICLIENTIFS" "DEFAULT_SOCIETY"
  DESCRIPTION =
 "Code de la societe par defaut sur laquelle est lancee l open interface"
  TABLE_NAME = "HR_ALL_ORGANIZATION_UNITS"
  COLUMN_NAME = "NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "0001"
END DKA_PARAMETER

