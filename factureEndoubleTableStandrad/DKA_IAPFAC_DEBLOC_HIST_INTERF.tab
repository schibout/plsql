BEGIN MESSAGE "DKA_POAP" "DOC_MANAGER_FAILED"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Echec du gestionnaire de documents"
  SUBJECT = "Le gestionnaire de documents a échoué suite à l'erreur numéro &DO\
C_MGR_ERROR_NUM pendant le traitement de &DOCUMENT_TYPE_DISP &DOCUMENT_NUMBER&\
RELEASE_NUM_DASH&RELEASE_NUM"
  BODY = "Le gestionnaire de documents a échoué à la suite de l'erreur numéro \
&DOC_MGR_ERROR_NUM.\n\
\n\
Erreur numéro 1 = Dépassement de délai du gestionnaire de documents.\n\
    Essayez d'arrêter et de relancer le gestionnaire de documents.\n\
\n\
Erreur numéro 2 = Le gestionnaire de documents ne fonctionne pas.\n\
     Lancez le programme simultané du gestionnaire de documents.\n\
\n\
Erreur numéro 3 = Erreur inconnue.\n\
     Contactez l'administrateur système.\n\
\n\
Messages d'erreur :\n\
&SYSADMIN_ERROR_MSG\n\
\n\
Le document traité est &DOCUMENT_TYPE_DISP &DOCUMENT_NUMBER \n\
Soumis par &PREPARER_USER_NAME\n\
\n\
Réparez l'erreur à l'aide du gestionnaire de documents et réessayez."
  DEFAULT_PRIORITY = "50"

  BEGIN MESSAGE_ATTRIBUTE "RESULT"
    DISPLAY_NAME = "Reprendre processus de workflow"
    DESCRIPTION = "Reprendre le processus de workflow après avoir résolu le pr\
oblème lié au gestionnaire de documents"
    FORMAT = "PO_RETRY_ACTION"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "RETRY"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DOC_MGR_ERROR_NUM"
