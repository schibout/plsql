BEGIN ACTIVITY "DKA_POAP" "SIGNER_POST_APPROVE_PROCESS"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Processus de post-approbation de signataire"
  DESCRIPTION = "Processus de post-approbation de signataire"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "N"

  BEGIN PROCESS_ACTIVITY "AME_PO_HAS_BEEN_SIGNED"
    ACTIVITY_ITEM_TYPE = "DKA_POAP"
    ACTIVITY_NAME = "AME_PO_HAS_BEEN_SIGNED"
    ICON_GEOMETRY = "96,-32"
    VALUE_TYPE = "ITEMATTR"
    PERFORM_ROLE = "PREPARER_USER_NAME"

    BEGIN ACTIVITY_TRANSITION "*" "AND"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;96,-32:272,-32:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "AME_PO_HAS_BEEN_SIGNED-1"
    ACTIVITY_ITEM_TYPE = "DKA_POAP"
    ACTIVITY_NAME = "AME_PO_HAS_BEEN_SIGNED"
    ICON_GEOMETRY = "64,-272"
    VALUE_TYPE = "ITEMATTR"
    PERFORM_ROLE = "PO_WF_NOTIF_PERFORMER"

    BEGIN ACTIVITY_TRANSITION "*" "OR"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;64,-272:272,-176:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "AND"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "AND"
    ICON_GEOMETRY = "272,-32"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "END-DOCUMENT_APPROVED_SIGNED"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;272,-32:416,-32:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "END-DOCUMENT_APPROVED_SIGNED"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "END"
    START_END = "END"
    ICON_GEOMETRY = "416,-32"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "OR"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "OR"
    ICON_GEOMETRY = "272,-176"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "AND"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;272,-176:272,-32:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "SEND_NOTIF_TO_WEB_SUPPLIER"
    ACTIVITY_ITEM_TYPE = "DKA_POAP"
    ACTIVITY_NAME = "SEND_NOTIF_TO_WEB_SUPPLIER"
    ICON_GEOMETRY = "-128,-176"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "N" "OR"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-128,-176:272,-176:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "Y" "AME_PO_HAS_BEEN_SIGNED-1"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-128,-176:64,-272:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "START"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "START"
    START_END = "START"
    ICON_GEOMETRY = "-304,-32"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "UPDATE_AUTH_STATUS_ESIGN"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-304,-32:-128,-32:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "UPDATE_AUTH_STATUS_ESIGN"
    ACTIVITY_ITEM_TYPE = "DKA_POAP"
    ACTIVITY_NAME = "UPDATE_AUTH_STATUS_ESIGN"
    ICON_GEOMETRY = "-128,-32"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "SEND_NOTIF_TO_WEB_SUPPLIER"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-128,-32:-128,-176:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "*" "AME_PO_HAS_BEEN_SIGNED"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-128,-32:96,-32:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY
END ACTIVITY

