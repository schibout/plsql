BEGIN ACTIVITY "ASOAPPRV" "NOTIFYAPPROVER"
  PROTECT_LEVEL = "100"
  CUSTOM_LEVEL = "100"
  DISPLAY_NAME = "NOTIFYAPPROVER"
  DESCRIPTION = "Aviser un approbateur et envoyer un rappel si l'approbateur n\
e répond pas dans le délai défini."
  TYPE = "PROCESS"
  RESULT_TYPE = "ASOAPPRV_APPROVAL"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "N"

  BEGIN PROCESS_ACTIVITY "APPROVE-END"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "END"
    START_END = "END"
    DEFAULT_RESULT = "APPROVED"
    ICON_GEOMETRY = "176,-31"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "LOOPCOUNTER"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "LOOPCOUNTER"
    ICON_GEOMETRY = "382,69"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "MAX_TIMES"
      VALUE_TYPE = "CONSTANT"
      VALUE = "2"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "EXIT" "TIMEOUT-END"
      ARROW_GEOMETRY = "0;0;2;0;0.515991;382,69:586,68:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "LOOP" "REM:REQUEST APPROVAL FROM APPR"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;382,69:576,144:384,224:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "OR"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "OR"
    ICON_GEOMETRY = "176,128"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "APPROVE-END"
      ARROW_GEOMETRY = "1;0;2;0;0.500000;176,128:176,-31:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "OR-1"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "OR"
    ICON_GEOMETRY = "178,313"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "REJECT-END"
      ARROW_GEOMETRY = "1;0;2;0;0.000000;178,313:176,411:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "REJECT-END"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "END"
    START_END = "END"
    DEFAULT_RESULT = "REJECTED"
    ICON_GEOMETRY = "176,411"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "REM:REQUEST APPROVAL FROM APPR"
    ACTIVITY_ITEM_TYPE = "ASOAPPRV"
    ACTIVITY_NAME = "NOTIFY_APPROVE_REQUISITION"
    ICON_GEOMETRY = "384,224"
    VALUE_TYPE = "ITEMATTR"
    PERFORM_ROLE = "RECEIVER_USERNAME"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#TIMEOUT"
      VALUE_TYPE = "CONSTANT"
      VALUE = "1440"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "MESSAGE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "MESSAGE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "PERFORMER"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "RECEIVER_USERNAME"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "EXPANDROLES"
      VALUE_TYPE = "CONSTANT"
      VALUE = "N"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "APPROVED" "OR"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;384,224:176,128:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "REJECTED" "OR-1"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;384,224:178,313:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "#TIMEOUT" "LOOPCOUNTER"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;384,224:382,69:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "REQUEST APPROVAL FROM APPROVER"
    ACTIVITY_ITEM_TYPE = "ASOAPPRV"
    ACTIVITY_NAME = "NOTIFY_APPROVE_REQUISITION"
    ICON_GEOMETRY = "128,208"
    VALUE_TYPE = "ITEMATTR"
    PERFORM_ROLE = "RECEIVER_USERNAME"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#TIMEOUT"
      VALUE_TYPE = "CONSTANT"
      VALUE = "1440"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "MESSAGE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "MESSAGE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "PERFORMER"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "RECEIVER_USERNAME"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "EXPANDROLES"
      VALUE_TYPE = "CONSTANT"
      VALUE = "N"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "APPROVED" "OR"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;128,208:176,128:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "REJECTED" "OR-1"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;128,208:178,313:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "#TIMEOUT" "LOOPCOUNTER"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;128,208:382,69:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "START"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "START"
    START_END = "START"
    ICON_GEOMETRY = "-128,208"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "REQUEST APPROVAL FROM APPROVER"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-128,208:128,208:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "TIMEOUT-END"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "END"
    START_END = "END"
    DEFAULT_RESULT = "TIMEOUT"
    ICON_GEOMETRY = "586,68"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY
END ACTIVITY

