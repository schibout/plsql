BEGIN MESSAGE "DKA_POAP" "PLSQL_ERROR_OCCURS"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Une erreur PL/SQL s'est produite"
