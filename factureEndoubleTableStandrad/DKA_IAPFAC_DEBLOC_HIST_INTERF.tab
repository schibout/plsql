BEGIN MESSAGE "DKA_POAP" "PO_PO_APPROVE"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Approuver l'ordre d'achat"
  SUBJECT = "&OPERATING_UNIT_NAME -  &DOCUMENT_TYPE_DISP &DOCUMENT_NUMBER&RELE\
ASE_NUM_DASH&RELEASE_NUM,&PO_REVISION_NUM pour &FUNCTIONAL_CURRENCY  &TOTAL_AM\
OUNT_DSP &REQUIRES_APPROVAL_MSG &WRONG_FORWARD_TO_MSG"
  BODY = "&DOCUMENT_TYPE_DISP &DOCUMENT_NUMBER&RELEASE_NUM_DASH&RELEASE_NUM, d\
'un montant de &TOTAL_AMOUNT_DSP &FUNCTIONAL_CURRENCY &REQUIRES_APPROVAL_MSG&W\
RONG_FORWARD_TO_MSG\n\
&DESCRIPTION\n\
\n\
Montant : &PO_AMOUNT_DSP &FUNCTIONAL_CURRENCY\n\
Taxe : &TAX_AMOUNT_DSP &FUNCTIONAL_CURRENCY\n\
Fournisseur : &SUPPLIER\n\
Site fournisseur : &SUPPLIER_SITE\n\
Description : &PO_DESCRIPTION\n\
\n\
\\Transmis par : &FORWARD_FROM_DISPLAY_NAME\n\
Emetteur : &PREPARER_DISPLAY_NAME\n\
Unité opérationnelle : &OPERATING_UNIT_NAME\n\
\n\
Note : &NOTE\n\
\n\
&PO_LINES_DETAILS\n\
\n\
&ACTION_HISTORY\n\
\n\
Pour plus de détails, ouvrez le document."
