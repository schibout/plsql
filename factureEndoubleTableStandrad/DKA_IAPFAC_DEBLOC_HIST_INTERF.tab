BEGIN MESSAGE "ASOAPPRV" "FYI_TO_REQUESTER"
  PROTECT_LEVEL = "100"
  CUSTOM_LEVEL = "100"
  DISPLAY_NAME = "FYI_TO_REQUESTER"
  DESCRIPTION = "Send FYI to Requester that request has been submitted for app\
roval"
  SUBJECT = "Quote &APPROVAL_OBJECT Has Been Sent For Approval To &RECEIVER_DI\
SPLAYNAME"
  BODY = "&QUOTE_DETAIL_URL\n\
\n\
 &QUOTE_SUMMARY_DOC  \n\
\n\
&REQUESTER_COMMENTS_DOC\n\
\n\
&APPROVER_DETAILS_DOC\n\
\n\
&RULE_DETAILS_DOC\n\
\n\
&QUOTE_DETAIL_URL\n\
\n"
  HTML_BODY = "<html> <body>\n\
<STYLE TYPE=text/css>\n\
.sectionHeader1 {\n\
        FONT-WEIGHT: bold; FONT-SIZE: 12pt; COLOR: #336699; FONT-FAMILY: Arial\
, Helvetica, sans-serif\n\
}\n\
.OraBGAccentDark {\n\
        BACKGROUND-COLOR: #cccc99\n\
}\n\
.tableSmallHeaderCell {\n\
        FONT-WEIGHT: bold; FONT-SIZE: 10pt; COLOR: #336699; FONT-FAMILY: Arial\
, Helvetica, sans-serif; BACKGROUND-COLOR:\n\
#cccc99\n\
}\n\
.tableDataCell {\n\
        FONT-SIZE: 9pt; FONT-FAMILY: Arial, Helvetica, Geneva, sans-serif; BAC\
KGROUND-COLOR: #f7f7e7\n\
}\n\
.requiredFieldPrompt {\n\
        FONT-SIZE: 10pt; FONT-FAMILY: Arial, Helvetica, sans-serif\n\
}\n\
.dataReadOnly {\n\
FONT-WEIGHT: bold; FONT-SIZE: 10pt; FONT-FAMILY: Arial, Helvetica, sans-serif\
\n\
}\n\
.prompt {\n\
        FONT-SIZE: 10pt; FONT-FAMILY: Arial, Helvetica, sans-serif\n\
}\n\
</STYLE>\n\
\n\
<br> <br>\n\
&QUOTE_DETAIL_URL\n\
<br> <br>\n\
 &QUOTE_SUMMARY_DOC  \n\
<br>\n\
&REQUESTER_COMMENTS_DOC\n\
<br>\n\
&APPROVER_DETAILS_DOC\n\
<br>\n\
&RULE_DETAILS_DOC\n\
