BEGIN ACTIVITY "ECXSTD" "OUTBOUND_B2B"
  PROTECT_LEVEL = "3"
  CUSTOM_LEVEL = "3"
  DISPLAY_NAME = "Créer message partenaire commercial (pour utilisation ECX in\
terne uniquement)"
  DESCRIPTION = "Créer un message de partenaire commercial (pour une utilisati\
on ECX interne uniquement)"
  TYPE = "PROCESS"
  RESULT_TYPE = "WFSTD_BOOLEAN"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "Y"

  BEGIN PROCESS_ACTIVITY "ECXRECEIVE"
    ACTIVITY_ITEM_TYPE = "ECXSTD"
    ACTIVITY_NAME = "ECXRECEIVE"
    START_END = "START"
    ICON_GEOMETRY = "-208,-16"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTNAME"
      VALUE_TYPE = "CONSTANT"
      VALUE = "ECX_EVENT_NAME"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTKEY"
      VALUE_TYPE = "CONSTANT"
      VALUE = "ECX_EVENT_KEY"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTMESSAGE"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTOUTAGENT"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTTOAGENT"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "GETTPXML"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-208,-16:-112,-16:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "END"
    ACTIVITY_ITEM_TYPE = "DKA_WFST"
    ACTIVITY_NAME = "END"
    START_END = "END"
    DEFAULT_RESULT = "T"
    ICON_GEOMETRY = "112,-16"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "GETTPXML"
    ACTIVITY_ITEM_TYPE = "ECXSTD"
    ACTIVITY_NAME = "GETTPXML"
    ICON_GEOMETRY = "-112,-16"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_TRANSACTION_TYPE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_TRANSACTION_TYPE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_TRANSACTION_SUBTYPE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_TRANSACTION_SUBTYPE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_DOCUMENT_ID"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_DOCUMENT_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARTY_SITE_ID"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARTY_SITE_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARTY_ID"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARTY_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_EVENT_NAME"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_EVENT_NAME"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_EVENT_KEY"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_EVENT_KEY"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARAMETER1"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARAMETER1"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARAMETER2"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARAMETER2"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARAMETER3"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARAMETER3"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARAMETER4"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARAMETER4"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARAMETER5"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARAMETER5"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_EVENT_MESSAGE"
      VALUE_TYPE = "CONSTANT"
      VALUE = "ECX_EVENT_MESSAGE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ECX_PARTY_TYPE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_PARTY_TYPE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "WFSEND"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-112,-16:0,-16:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "WFSEND"
    ACTIVITY_ITEM_TYPE = "ECXSTD"
    ACTIVITY_NAME = "WFSEND"
    ICON_GEOMETRY = "0,-16"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTNAME"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_EVENT_NAME"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTKEY"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_EVENT_KEY"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTMESSAGE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_EVENT_MESSAGE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTOUTAGENT"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#EVENTTOAGENT"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#BLOCK_MODE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_BLOCK_MODE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#CB_EVENT_NAME"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_CB_EVENT_NAME"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "#CB_EVENT_KEY"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ECX_CB_EVENT_KEY"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "END"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;0,-16:112,-16:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY
END ACTIVITY

