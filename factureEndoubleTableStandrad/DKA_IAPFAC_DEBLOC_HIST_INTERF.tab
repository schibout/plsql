    DESCRIPTION = "Numéro d'erreur gestionnaire de documents"
    TYPE = "NUMBER"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "DOC_MGR_ERROR_NUM"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DOCUMENT_TYPE_DISP"
