    SUBTYPE = "SEND"
    FORMAT = "240"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "DOCUMENT_TYPE_DISP"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DOCUMENT_NUMBER"
    DISPLAY_NAME = "Numéro d'ordre d'achat"
    DESCRIPTION = "Numéro d'ordre d'achat"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "20"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "DOCUMENT_NUMBER"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "RELEASE_NUM_DASH"
    DISPLAY_NAME = "Séparateur tiret du numéro d'appel de commande"
    DESCRIPTION = "Séparateur tiret du numéro d'appel de commande"
