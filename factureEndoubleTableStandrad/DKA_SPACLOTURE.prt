# PHENIX 2004 : SFE 30/08/2004
# Modification du parametre "SARENCAIS"/"AR_RESPONSIBILITY_KEY"
# 	"ARXXXX ADMINISTRATEUR" -> "DK_RECEIVABLES_MANAGER"
# Modification du parametre "SARENCAIS" "FORMAT"
#	"CONVERTIR" -> "CONVERT"

LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions --

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions --


BEGIN DKA_PARAMETER "SARENCAIS" "FORMAT"
  DESCRIPTION = "Format de transmission"
  TABLE_NAME = "AR_TRANSMISSION_FORMATS"
  COLUMN_NAME = "FORMAT_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "CONVERT"			# PHENIX 2004: "CONVERTIR" -> "CONVERT"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARENCAIS" "STATUS"
  DESCRIPTION = "Status de règlement"
  TABLE_NAME = "FND_LOOKUP_VALUES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "NEGOTIABLE"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARENCAIS" "TYPE_FOUR"
  DESCRIPTION = "type de fournisseurs"
  TABLE_NAME = "FND_LOOKUP_VALUES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "PARTENAIRE"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARENCAIS" "TYPE_REGL"
  DESCRIPTION = "Type de règlement"
  TABLE_NAME = "FND_LOOKUP_VALUES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "EFT"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARENCAIS" "AR_RESPONSIBILITY_KEY"
  DESCRIPTION = "Clé de la responsabilité AR"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "_AR_ADMINISTRATEUR" # "DK_RECEIVABLES_MANAGER"	# PHENIX 2004: "ARXXXX ADMINISTRATEUR" -> "DK_RECEIVABLES_MANAGER"
END DKA_PARAMETER

