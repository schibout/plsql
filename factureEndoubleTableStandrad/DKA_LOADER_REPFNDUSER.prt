LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions --

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions --


BEGIN DKA_PARAMETER "SPASINISTRE" "EVENT_TYPE_CCA"
  DESCRIPTION = "Type d'évenement CCA"
  TABLE_NAME = "PA_EVENT_TYPES"
  COLUMN_NAME = "EVENT_TYPE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "CCA SINISTRES FIN"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPASINISTRE" "EVENT_TYPE_CCAI"
  DESCRIPTION = "Type d'évenement CCA"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "CCA SINISTRES FIN IND."
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPASINISTRE" "ATTRIBUTE_CATEGORY"
  DESCRIPTION = "Valeur contextuelle de l''attribute category"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "CCA"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPASINISTRE" "EVENT_TYPE_ETAT_FRAIS"
