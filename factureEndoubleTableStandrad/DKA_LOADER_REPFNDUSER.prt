BEGIN DKA_PARAMETER "SPASINISTRE" "GL_RESP_KEY"
  DESCRIPTION =
 "Clé de la responsabilité GL utilisée pour lancer un traitement"
  TABLE_NAME = "FND_RESPONSIBILITY"
  COLUMN_NAME = "RESPONSIBILITY_KEY"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "TOUT_GL_OPE_ADMINISTRATEUR"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SPASINISTRE" "PROJECT_TYPE_SINISTRE_CLASS"
