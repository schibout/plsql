BEGIN MESSAGE "APINVAPR" "DOCUMENT_APPROVAL_MSG"
  PROTECT_LEVEL = "20"
  CUSTOM_LEVEL = "20"
  DISPLAY_NAME = "Message d'approbation de document"
  SUBJECT = "La facture &#HDR_INVOICE_NUMBER de &#HDR_INVOICE_SUPPLIER_NAME re\
quiert votre approbation"
  BODY = "&DOCUMENT_APPROVAL_LINES"
  DEFAULT_PRIORITY = "50"

  BEGIN MESSAGE_ATTRIBUTE "RESULT"
    DISPLAY_NAME = "RESULT"
    DESCRIPTION = "RESULT"
    FORMAT = "WFSTD_APPROVAL"
    VALUE_TYPE = "CONSTANT"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HDR_INVOICE_SUPPLIER_NAME"
    DISPLAY_NAME = "Nom du fournisseur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "80"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_SUPPLIER_NAME"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HDR_INVOICE_SUPPLIER_SITE"
    DISPLAY_NAME = "Site fournisseur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "15"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_SUPPLIER_SITE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HDR_INVOICE_NUMBER"
    DISPLAY_NAME = "Numéro de facture"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "50"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_NUMBER"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HDR_INVOICE_DATE"
    DISPLAY_NAME = "Date de la facture"
    TYPE = "DATE"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_DATE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HDR_INVOICE_DESCRIPTION"
    DISPLAY_NAME = "Description de la facture"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "240"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_DESCRIPTION"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HDR_INVOICE_TOTAL"
    DISPLAY_NAME = "Total facture"
    TYPE = "NUMBER"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_TOTAL"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#ATTACHMENTS"
    DISPLAY_NAME = "#ATTACHMENTS"
    TYPE = "DOCUMENT"
    SUBTYPE = "SEND"
    FORMAT = "_top"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_ATTACHMENTS"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "INVOICE_TOTAL"
    DISPLAY_NAME = "Total"
    TYPE = "NUMBER"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_TOTAL"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "INVOICE_CURRENCY_CODE"
    DISPLAY_NAME = "Code devise de la facture"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "15"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_CURRENCY_CODE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "WF_NOTE"
    DISPLAY_NAME = "Note"
    TYPE = "VARCHAR2"
    SUBTYPE = "RESPOND"
    FORMAT = "240"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "WF_NOTE"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "DOCUMENT_APPROVAL_LINES"
    DISPLAY_NAME = "Approbation de document - Lignes"
    TYPE = "DOCUMENT"
    SUBTYPE = "SEND"
    FORMAT = "_self"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "JSP:/OA_HTML/OA.jsp?page=/oracle/apps/ap/invoice/request/negoti\
ation/webui/NotifPGRN&INVOICEID=-&INVOICE_ID-"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#HIDE_REASSIGN"
    DISPLAY_NAME = "HIDE REASSIGN"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "1"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "N"
  END MESSAGE_ATTRIBUTE

  BEGIN MESSAGE_ATTRIBUTE "#FROM_ROLE"
    DISPLAY_NAME = "Rôle émetteur"
    DESCRIPTION = "Rôle émetteur"
    TYPE = "VARCHAR2"
    SUBTYPE = "SEND"
    FORMAT = "50"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "Accounts Payable"
