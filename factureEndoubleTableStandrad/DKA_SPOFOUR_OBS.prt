  BEGIN MESSAGE_ATTRIBUTE "INVOICE_ID"
    DISPLAY_NAME = "INVOICE_ID"
    TYPE = "NUMBER"
    SUBTYPE = "SEND"
    VALUE_TYPE = "ITEMATTR"
    DEFAULT = "INVOICE_ID"
  END MESSAGE_ATTRIBUTE

