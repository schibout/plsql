    DISPLAY_NAME = "Voir les détails supplémentaires de la facture"
    TYPE = "URL"
    SUBTYPE = "SEND"
    FORMAT = "_top"
    VALUE_TYPE = "CONSTANT"
    DEFAULT = "JSP:/OA_HTML/OA.jsp?OAFunc=AP_INV_LINE_DETAILS&INVOICEID=-&INVO\
ICE_ID-&NOTIFICATIONCONTEXT=APPROVALDOCUMENT&ISINTERNAL=Y&ITEMKEY=-&NOTIFICATI\
ON_KEY-&notificationId=-&#NID-&PINSTANCELABEL=DOCUMENT_APPROVAL_REQUEST"
