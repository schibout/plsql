BEGIN FND_NEW_MESSAGES "DKA" "DKA_SICXRECHCAT_INFO"
  OWNER = "AAMENKOUR"
  LAST_UPDATE_DATE = "2019/06/11"
  MESSAGE_NUMBER = "*NULL*"
  MESSAGE_TEXT =
 "<html>\n\
<body>\n\
<p align=\"center\"><font size=\"2\" color=\"#FF0000\">&&nbsp;&&nbsp;&&nbsp;LA PAGE DE RECHERCHE A ÉTÉ MODIFIÉE POUR AMÉLIORER SON UTILISATION&&nbsp;&&nbsp;&&nbsp;<font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#000000\">&&nbsp;&&nbsp;Profitez grâce à la recherche par référence de la codification, et trouvez pour une référence l'ensemble des articles correspondants à votre besoin.&&nbsp;&&nbsp;</font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#000000\"><B><u>Les familles codifiées à ce jour sont:</u></B><font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#1560BD\"><B>&&nbsp;&&nbsp;Chaudières&&nbsp;&&nbsp;</B></font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#1560BD\"><B>&&nbsp;&&nbsp;Tubes pré-isolé&&nbsp;&&nbsp;</B></font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#1560BD\"><B>&&nbsp;&&nbsp;Robinetterie tertiaire&&nbsp;&&nbsp;</B></font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#1560BD\"><B>&&nbsp;&&nbsp;Tuyauterie&&nbsp;&&nbsp;</B></font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#1560BD\"><B>&&nbsp;&&nbsp;Câbles et conduits&&nbsp;&&nbsp;</B></font></p>\n\
<p align=\"center\"><font size=\"2\" color=\"#000000\"><B>&&nbsp;Rendez-vous sur le lien ci-contre pour retrouver le calendrier de la codification&&nbsp;</B><font></p>\n\
<p align=\"center\"><font size=\"2\" style=\"color:blue;\"><u><a href=\"https://docs.google.com/spreadsheets/d/1l-iT9vUNIelro7sMw6MtAvEHizkBQSSDG2NeEcJiAXg/edit#gid=0\" style=\"color:blue;\" target=\"_blank\">https://docs.google.com/spreadsheets/d/1l-iT9vUNIelro7sMw6MtAvEHizkBQSSDG2NeEcJiAXg/edit#gid=0</a></u></font></p>\n\
</body>\n\
</html>"
  DESCRIPTION = "*NULL*"
  TYPE = "30_PCT_EXPANSION_PROMPT"
  MAX_LENGTH = "*NULL*"
  CATEGORY = "*NULL*"
  SEVERITY = "*NULL*"
  FND_LOG_SEVERITY = "*NULL*"
END FND_NEW_MESSAGES

