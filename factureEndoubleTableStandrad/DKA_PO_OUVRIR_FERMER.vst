DEFINE DF_SEGMENT
  KEY   APPSNAME                        VARCHAR2(50)
  KEY   FLEXFIELD_NAME                  VARCHAR2(40)
  KEY   CONTEXT_CODE                    VARCHAR2(45)
  KEY   NAME                            VARCHAR2(30)
  BASE  COLUMN                          VARCHAR2(30)
  BASE  SEQUENCE_NUMBER                 VARCHAR2(50)
  BASE  ENABLED                         VARCHAR2(1)
  BASE  DISPLAYED                       VARCHAR2(1)
  BASE  VALUE_SET                       VARCHAR2(60)
  BASE  DEFAULT_TYPE                    VARCHAR2(80)
  BASE  DEFAULT_VALUE                   VARCHAR2(2000)
  BASE  REQUIRED                        VARCHAR2(1)
  BASE  SECURITY_ENABLED                VARCHAR2(1)
  BASE  DISPLAY_SIZE                    VARCHAR2(50)
  BASE  DESCRIPTION_SIZE                VARCHAR2(50)
  BASE  CONCAT_DESC_SIZE                VARCHAR2(50)
  BASE  RANGE                           VARCHAR2(80)
  TRANS LOV_PROMPT                      VARCHAR2(80)
  TRANS WIN_PROMPT                      VARCHAR2(80)
  TRANS DESCRIPTION                     VARCHAR2(240)
END DF_SEGMENT

# -- End Entity Definitions -- 


