# -- Begin Entity Definitions -- 

DEFINE DF_SETUP
  KEY   APPSNAME                        VARCHAR2(50)
  KEY   FLEXFIELD_NAME                  VARCHAR2(40)
  BASE  SEGMENT_SEPARATOR               VARCHAR2(1)
  BASE  DEFAULT_VALUE                   VARCHAR2(30)
  BASE  REFERENCE_FIELD                 VARCHAR2(200)
  BASE  VALUE_REQUIRED                  VARCHAR2(1)
  BASE  OVERRIDE_ALLOWED                VARCHAR2(1)
  TRANS PROMPT                          VARCHAR2(45)
END DF_SETUP

# -- End Entity Definitions -- 


BEGIN DF_SETUP "PO" "PO_HEADERS"
  SEGMENT_SEPARATOR = "."
  VALUE_REQUIRED = "N"
  OVERRIDE_ALLOWED = "N"
  PROMPT = "Contexte"
END DF_SETUP

