  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "15"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION =
 "Devises comptables pour un livre, une devise de reporting retraitee, une devise de reporting MRC ou un jeu de livres."


  BEGIN VSET_TABLE
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2007/12/23 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "SQLGL"
    APPLICATION_TABLE_NAME = "FND_CURRENCIES CURR"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "CURR.CURRENCY_CODE"
    VALUE_COLUMN_TYPE = "V"
    VALUE_COLUMN_SIZE = "15"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "CURR.CURRENCY_CODE IN\n\
  (SELECT REL.TARGET_CURRENCY_CODE\n\
  FROM GL_LEDGER_RELATIONSHIPS REL\n\
  WHERE REL.TARGET_LEDGER_SHORT_NAME = :$FLEX$.GL_SRS_LEDGER_WITH_SETS_AND_ALCS_STORE_SHORT_NAME\n\
  UNION\n\
  SELECT REL.TARGET_CURRENCY_CODE\n\
  FROM GL_LEDGER_SET_ASSIGNMENTS LS, GL_LEDGER_RELATIONSHIPS REL\n\
  WHERE LS.LEDGER_SET_ID = :$FLEX$.GL_SRS_LEDGER_ID_UNVALIDATED\n\
  AND REL.SOURCE_LEDGER_ID = LS.LEDGER_ID\n\
  AND REL.TARGET_LEDGER_ID = LS.LEDGER_ID)"
  END VSET_TABLE
  





END VALUE_SET

