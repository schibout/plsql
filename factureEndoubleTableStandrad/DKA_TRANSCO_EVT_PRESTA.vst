BEGIN VALUE_SET "GL_SRS_LEDGER_WITH_SETS_AND_ALCS_STORE_SHORT_NAME"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2007/12/23 00:00:00"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "30"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION =
 "Jeux de livres, livres et devises de reporting retraitees associes a un jeu d'acces. Affiche le nom complet, stocke le nom abrege."


  BEGIN VSET_TABLE
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2007/12/23 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "SQLGL"
    APPLICATION_TABLE_NAME =
 "GL_ACCESS_SET_LEDGERS AC, GL_LEDGERS LED, GL_LEDGER_RELATIONSHIPS REL"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "NVL(REL.TARGET_LEDGER_NAME, LED.NAME)"
    VALUE_COLUMN_TYPE = "V"
    VALUE_COLUMN_SIZE = "30"
    ID_COLUMN_NAME = "NVL(REL.TARGET_LEDGER_SHORT_NAME, LED.SHORT_NAME)"
    ID_COLUMN_TYPE = "V"
    ID_COLUMN_SIZE = "20"
    MEANING_COLUMN_NAME = "LED.DESCRIPTION"
    MEANING_COLUMN_TYPE = "V"
    MEANING_COLUMN_SIZE = "240"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "WHERE AC.ACCESS_SET_ID = :$PROFILES$.GL_ACCESS_SET_ID\n\
  AND LED.LEDGER_ID=AC.LEDGER_ID\n\
  AND REL.SOURCE_LEDGER_ID(+)=AC.LEDGER_ID\n\
  AND REL.TARGET_LEDGER_ID(+)=AC.LEDGER_ID\n\
  AND REL.APPLICATION_ID(+)=101\n\
  ORDER BY NVL(REL.TARGET_LEDGER_NAME, LED.NAME)"
  END VSET_TABLE
  





END VALUE_SET

