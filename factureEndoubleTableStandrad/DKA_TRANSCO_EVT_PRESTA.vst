BEGIN VALUE_SET "GL_SRS_PERIOD_NAME_FOR_LEDGER_SET"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2007/12/23 00:00:00"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "15"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION =
 "Tous les noms de periode ouverte, fermee ou definitivement fermee dans n'importe quel livre d'un jeu de livres."


  BEGIN VSET_TABLE
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2007/12/23 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "SQLGL"
    APPLICATION_TABLE_NAME = "GL_LEDGERS LED, GL_PERIODS PER"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "PER.PERIOD_NAME"
    VALUE_COLUMN_TYPE = "V"
    VALUE_COLUMN_SIZE = "15"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "WHERE led.ledger_id = :$FLEX$.GL_SRS_LEDGER_ID_UNVALIDATED\n\
  AND   per.period_set_name = led.period_set_name\n\
  AND   per.period_type = led.accounted_period_type\n\
  AND EXISTS (\n\
  SELECT 'has data'\n\
  FROM gl_ledgers led2,\n\
  gl_ledger_set_assignments ls,\n\
  gl_ledger_relationships rel,\n\
  gl_period_statuses ps\n\
  WHERE led2.ledger_id = led.ledger_id\n\
  AND   ls.ledger_set_id (+) = led2.ledger_id\n\
  AND   rel.source_ledger_id = nvl(ls.ledger_id, led.ledger_id)\n\
  AND   rel.target_ledger_id = nvl(ls.ledger_id, led.ledger_id)\n\
  AND   rel.target_currency_code = :$FLEX$.GL_SRS_LEDGER_CURRENCIES\n\
  AND   ps.application_id = 101\n\
  AND   ps.ledger_id = rel.source_ledger_id\n\
  AND   ps.closing_status IN ('O','C','P')\n\
  AND   ps.period_name = per.period_name)\n\
  order by per.period_year, per.period_num\n\
  "
  END VSET_TABLE
  





END VALUE_SET

