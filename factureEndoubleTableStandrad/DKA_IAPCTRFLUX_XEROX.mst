  MLS_EXEC = "" ""
  ENABLE_TIME_STATISTICS = "N"
  SRS_FLEX = "DKA" "$SRS$.DKA_ARXCOA2"
  AUTO_ANNOTATION =
 "/**\n\
  * @param Concurrent%_Request%_Id Numéro du traitement simultané\n\
  * @rep:paraminfo {@rep:type 7/Number} {@rep:displayed N}\n\
  * @param Report%_Format%_Option Option du format d'édition\n\
  * @rep:paraminfo {@rep:type AR_ARXCOA2_FORMAT_OPTION} {@rep:displayed Y} {@rep:required}\n\
  * @param Receipt%_GL%_Date%_Low Début de la fourchette des dates GL de règlement\n\
  * @rep:paraminfo {@rep:type FND_STANDARD_DATE} {@rep:displayed Y}\n\
  * @param Receipt%_GL%_Date%_High Fin de la fourchette des dates GL de règlement\n\
  * @rep:paraminfo {@rep:type FND_STANDARD_DATE} {@rep:displayed Y}\n\
  * @param Currency%_Code Code devise\n\
  * @rep:paraminfo {@rep:type AR_SRS_CURRENCY} {@rep:displayed Y}\n\
  * @param Customer%_Name%_Low Début de la fourchette des noms de client\n\
  * @rep:paraminfo {@rep:type AR_CUSTOMER_NAME} {@rep:displayed Y}\n\
  * @param Customer%_Name%_High Fin de la fourchette des noms de client\n\
  * @rep:paraminfo {@rep:type AR_CUSTOMER_NAME} {@rep:displayed Y}\n\
  * @param Customer%_Number%_Low Début fourchette numéros de client\n\
  * @rep:paraminfo {@rep:type AR_CUSTOMER_NUMBER} {@rep:displayed Y}\n\
  * @param Customer%_Number%_High Fin fourchette numéros de client\n\
  * @rep:paraminfo {@rep:type AR_CUSTOMER_NUMBER} {@rep:displayed Y}\n\
  * @param Batch%_Name%_Low Début de la fourchette des noms de lot\n\
  * @rep:paraminfo {@rep:type AR_BATCH_NAME} {@rep:displayed Y}\n\
  * @param Batch%_Name%_High Fin de la fourchette des noms de lot\n\
  * @rep:paraminfo {@rep:type AR_BATCH_NAME} {@rep:displayed Y}\n\
  * @param Batch%_Source%_Name%_Low Début fourchette noms origine du lot\n\
  * @rep:paraminfo {@rep:type AR_BATCH_SOURCE_NAME} {@rep:displayed Y}\n\
  * @param Batch%_Source%_Name%_High Fin fourchette noms origine du lot\n\
  * @rep:paraminfo {@rep:type AR_BATCH_SOURCE_NAME} {@rep:displayed Y}\n\
  * @param Receipt%_Number%_Low Début de la fourchette des numéros de règlement\n\
  * @rep:paraminfo {@rep:type AR_RECEIPT_NUMBER} {@rep:displayed Y}\n\
  * @param Receipt%_Number%_High Fin de la fourchette des numéros de règlement\n\
  * @rep:paraminfo {@rep:type AR_RECEIPT_NUMBER} {@rep:displayed Y}\n\
  * @param DKA_calcul_soldes_prec Calcul des soldes de l'année précédente\n\
  * @rep:paraminfo {@rep:type 1 char} {@rep:displayed Y} {@rep:required}\n\
  * @param P_SOCIETE Société\n\
  * @rep:paraminfo {@rep:type DKA_SOCIETES_GL_ACCESS} {@rep:displayed Y} {@rep:required}\n\
  * @param Chart%_of%_Accounts Indique le plan de comptes\n\
  * @rep:paraminfo {@rep:type AR_CHART_OF_ACCOUNTS_NO_VALIDATION} {@rep:displayed N} {@rep:required}\n\
  * @param Set%_Of%_Books Livre\n\
  * @rep:paraminfo {@rep:type AR_SRS_SET_OF_BOOKS_ID} {@rep:displayed N} {@rep:required}\n\
  */"
