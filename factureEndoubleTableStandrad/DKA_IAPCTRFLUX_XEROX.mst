BEGIN VALUE_SET "DKA_SOCIETES_GL_ACCESS"
  OWNER = "CAPTECH"
  LAST_UPDATE_DATE = "2016/12/06 19:02:05"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "4"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION =
 "Jeux des sociétés selon l'option de profile \"GL Jeu d'accès aux données\"."


  BEGIN VSET_TABLE
    OWNER = "CAPTECH"
    LAST_UPDATE_DATE = "2016/12/06 19:30:36"
    TABLE_APPLICATION_SHORT_NAME = "DKA"
    APPLICATION_TABLE_NAME =
 "fnd_flex_value_sets  ffvs,  fnd_flex_values_vl  ffvv,  gl_ledgers gl"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "ffvv.flex_value"
    VALUE_COLUMN_TYPE = "C"
    VALUE_COLUMN_SIZE = "4"
    MEANING_COLUMN_NAME = "ffvv.DESCRIPTION"
    MEANING_COLUMN_TYPE = "C"
    MEANING_COLUMN_SIZE = "30"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "ffvs.flex_value_set_name = 'DAOPCCF_STE'\n\
AND ffvs.flex_value_set_id = ffvv.FLEX_VALUE_SET_ID\n\
AND ffvv.ENABLED_FLAG = 'Y'\n\
AND SYSDATE BETWEEN nvl(ffvv.START_DATE_ACTIVE,SYSDATE) AND nvl(ffvv.END_DATE_ACTIVE,SYSDATE)\n\
AND gl.short_name = ffvv.flex_value\n\
AND gl.ledger_category_code = 'PRIMARY' \n\
AND gl.ledger_id IN (SELECT ledger_id FROM   gl_access_set_ledgers  WHERE access_set_id = fnd_profile.value('GL_ACCESS_SET_ID'))\n\
ORDER BY ffvv.flex_value"
  END VSET_TABLE
  





END VALUE_SET

