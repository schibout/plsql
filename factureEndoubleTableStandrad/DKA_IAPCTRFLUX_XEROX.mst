BEGIN VALUE_SET "AR_CUSTOMER_NAME"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2013/11/22 00:00:00"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "Y"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "50"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Nom de la partie"


  BEGIN VSET_TABLE
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2013/11/22 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "AR"
    APPLICATION_TABLE_NAME = "HZ_CUST_ACCOUNTS cu, HZ_PARTIES party"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "party.party_name"
    VALUE_COLUMN_TYPE = "V"
    VALUE_COLUMN_SIZE = "50"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "TO_DATE(NULL)"
    END_DATE_COLUMN_NAME = "TO_DATE(NULL)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "WHERE cu.party_id = party.party_id and\n\
  cu.cust_account_id IN (select cu2.cust_account_id\n\
  from   hz_cust_accounts cu2, hz_parties party2\n\
  where  cu2.party_id = party2.party_id\n\
  and  party2.party_name =\n\
  party.party_name)\n\
  ORDER BY party.party_name"
    ADDITIONAL_QUICKPICK_COLUMNS =
 "cu.ACCOUNT_NUMBER \"Customer Number\"(20), PARTY.JGZZ_FISCAL_CODE \"Fiscal Code\"(15), PARTY.TAX_REFERENCE \"VAT Number\"(15)"
  END VSET_TABLE
  





END VALUE_SET

