# $Header$

# dbdrv: exec fnd bin FNDLOAD bin &phase=daa+52 checkfile:~PROD:~PATH:~FILE &ui_apps 0 Y UPLOAD @FND:patch/115/import/afmdmsg.lct @~PROD:~PATH/~FILE
LANGUAGE = "F"
LDRCONFIG = "afmdmsg.lct 120.2.12020000.1"

#Source Database HELINT

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE FND_NEW_MESSAGES
  KEY   APPLICATION_SHORT_NAME          VARCHAR2(50)
  KEY   MESSAGE_NAME                    VARCHAR2(30)
  CTX   OWNER                           VARCHAR2(4000)
  BASE  LAST_UPDATE_DATE                VARCHAR2(10)
  CTX   MESSAGE_NUMBER                  VARCHAR2(50)
  TRANS MESSAGE_TEXT                    VARCHAR2(2000)
  CTX   DESCRIPTION                     VARCHAR2(240)
  CTX   TYPE                            VARCHAR2(30)
  CTX   MAX_LENGTH                      VARCHAR2(50)
  CTX   CATEGORY                        VARCHAR2(10)
  CTX   SEVERITY                        VARCHAR2(10)
  CTX   FND_LOG_SEVERITY                VARCHAR2(50)
END FND_NEW_MESSAGES

# -- End Entity Definitions -- 


BEGIN FND_NEW_MESSAGES "DKA" "DKA_ETA121_CORPS"
  OWNER = "SCHARKAOUI"
  LAST_UPDATE_DATE = "2019/10/11"
  MESSAGE_NUMBER = "*NULL*"
  MESSAGE_TEXT =
 "<P>Bonjour,<br>\n\
<br>Vous trouverez ci-joint l'état des mouvements éligibles au prélèvement automatique en date d'écheance au &DATE_ECHEANCE pour la région &REGION.<br>\n\
<br>Cordialement.</P>\n\
"
  DESCRIPTION = "*NULL*"
  TYPE = "30_PCT_EXPANSION_PROMPT"
  MAX_LENGTH = "*NULL*"
  CATEGORY = "*NULL*"
  SEVERITY = "*NULL*"
  FND_LOG_SEVERITY = "*NULL*"
END FND_NEW_MESSAGES

BEGIN FND_NEW_MESSAGES "DKA" "DKA_ETA122_CORPS"
  OWNER = "JWYCKAER"
  LAST_UPDATE_DATE = "2019/11/12"
  MESSAGE_NUMBER = "*NULL*"
  MESSAGE_TEXT =
 "<P>Bonjour,<br>\n\
<br>Vous trouverez ci-joint l'état provisoire des prélèvements clients en date d'écheance au &DATE_ECHEANCE pour la région &REGION.<br>\n\
<br><strong>Sans intervention de votre part sur les lots de règlements, les prélèvements prévus dans l'état feront l'objet de création de règlements en statut Confirmé.</strong><br>\n\
<br>Cordialement.</P>\n\
"
  DESCRIPTION = "*NULL*"
  TYPE = "30_PCT_EXPANSION_PROMPT"
  MAX_LENGTH = "*NULL*"
  CATEGORY = "*NULL*"
  SEVERITY = "*NULL*"
  FND_LOG_SEVERITY = "*NULL*"
END FND_NEW_MESSAGES

BEGIN FND_NEW_MESSAGES "DKA" "DKA_ETA123_CORPS"
  OWNER = "JWYCKAER"
  LAST_UPDATE_DATE = "2019/11/12"
  MESSAGE_NUMBER = "*NULL*"
  MESSAGE_TEXT =
 "<P>Bonjour,<br>\n\
<br>Vous trouverez ci-joint l'état des prélèvements clients créés uniquement en automatique en statut confirmé en date d'échéance au &DATE_ECHEANCE pour la région &REGION.<br>\n\
<br>Cordialement.</P>\n\
"
  DESCRIPTION = "*NULL*"
  TYPE = "30_PCT_EXPANSION_PROMPT"
  MAX_LENGTH = "*NULL*"
  CATEGORY = "*NULL*"
  SEVERITY = "*NULL*"
  FND_LOG_SEVERITY = "*NULL*"
END FND_NEW_MESSAGES