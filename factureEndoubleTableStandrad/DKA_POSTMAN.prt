END MESSAGE

BEGIN ACTIVITY "FAFLEXWF" "ALT_BOOK_ACOUNT_GENERATION"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Générer un niveau de livre pour le détail de l'imputation"
  DESCRIPTION = "Génère un CCID pour un compte au niveau du livre"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "Y"

  BEGIN PROCESS_ACTIVITY "CHECK_BOOK_ACOUNT"
    ACTIVITY_ITEM_TYPE = "FAFLEXWF"
    ACTIVITY_NAME = "CHECK_BOOK_ACOUNT"
    ICON_GEOMETRY = "-308,-103"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "FND_FLEX_ASSIGN_TO_SEGMENT"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-308,-103:-48,-96:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "END"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "END"
    START_END = "END"
    ICON_GEOMETRY = "364,-103"
    VALUE_TYPE = "CONSTANT"
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "FND_FLEX_ASSIGN_TO_SEGMENT"
    ACTIVITY_ITEM_TYPE = "FNDFFWK"
    ACTIVITY_NAME = "FND_FLEX_ASSIGN_TO_SEGMENT"
    ICON_GEOMETRY = "-48,-96"
    VALUE_TYPE = "CONSTANT"
    USER_COMMENT = "Acount Segment from the Book Control"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "SEGMENT_IDENTIFIER"
      VALUE_TYPE = "CONSTANT"
      VALUE = "QUALIFIER"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "SEGMENT"
      VALUE_TYPE = "CONSTANT"
      VALUE = "GL_ACCOUNT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "VALUE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "ACCT_SEG_VAL"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "REPLACE_CURRENT_VALUE"
      VALUE_TYPE = "CONSTANT"
      VALUE = "FALSE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "FND_FLEX_COPY_FROM_COMB"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-48,-96:178,-104:216,-104:226,-106:20\
8,-112:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "FND_FLEX_COPY_FROM_COMB"
    ACTIVITY_ITEM_TYPE = "FNDFFWK"
    ACTIVITY_NAME = "FND_FLEX_COPY_FROM_COMB"
    ICON_GEOMETRY = "208,-112"
    VALUE_TYPE = "CONSTANT"
    USER_COMMENT = "Unqualified Segments from Default CCID"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "CODE_COMBINATION_ID"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "DISTRIBUTION_CCID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "REPLACE_CURRENT_VALUE"
      VALUE_TYPE = "CONSTANT"
      VALUE = "FALSE"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "END"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;208,-112:364,-103:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "START"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "START"
    START_END = "START"
    ICON_GEOMETRY = "-412,-103"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "CHECK_BOOK_ACOUNT"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-412,-103:-308,-103:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY
END ACTIVITY

BEGIN ACTIVITY "FAFLEXWF" "ALT_CATE_ACCOUNT_GENERATION"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Générer un niveau de catégorie pour le détail de l'imputatio\
n"
  DESCRIPTION = "Génère un CCID pour un compte au niveau de la catégorie"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
