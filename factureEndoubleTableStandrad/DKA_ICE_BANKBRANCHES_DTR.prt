LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

#Source Database DT2OAP

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 

BEGIN DKA_PARAMETER "DKA_IAPFACTTDS" "DATE_DERNIERE_EXTRACTION"
  DESCRIPTION = "Date de lancement de la derniere extraction"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "DATE"
  DATE_VALUE = "01/01/2018 00:00:00"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_IAPFACTTDS" "PREFIXE_IMAGE_XEROX"
  DESCRIPTION = "Prefixe des images des factures XEROX"
  TABLE_NAME = ""
  COLUMN_NAME = ""
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "VE"
END DKA_PARAMETER

