LANGUAGE = "F"
LDRCONFIG = "DKA_XX_PARAM.lct"

#Source Database HELDEV

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 


BEGIN DKA_PARAMETER "TOOLS" "INSERT_EVENT_REVENUE_SOURCE"
  DESCRIPTION = "Source du revenu de l'évenement"
  TABLE_NAME = "PA_LOOKUPS"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Event"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "TOOLS" "INSERT_EVENT_USER_JE_CATEGORY_NAME"
  DESCRIPTION = "Catégorie de piece GL"
  TABLE_NAME = "GL_JE_CATEGORIES"
  COLUMN_NAME = "USER_JE_CATEGORY_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Produit"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "TOOLS" "INSERT_EVENT_USER_JE_SOURCE_NAME"
  DESCRIPTION = "Source de piece GL"
  TABLE_NAME = "GL_JE_SOURCES"
  COLUMN_NAME = "USER_JE_SOURCE_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Projets"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "TOOLS" "PROJECT_TYPE_REFAC"
  DESCRIPTION = "Type de projet Refac"
  TABLE_NAME = "PA_PROJECT_TYPES_ALL"
  COLUMN_NAME = "PROJECT_TYPE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "REFAC"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "TOOLS" "BASE_PRODUCTION"
  DESCRIPTION = "Type d'environnement"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "DBOFINP1"
END DKA_PARAMETER


