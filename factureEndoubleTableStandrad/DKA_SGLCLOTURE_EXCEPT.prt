# $Header$

# 
LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

#Source Database DT1OAP

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 


BEGIN DKA_PARAMETER "DKA_SPORECEP" "DATE_FIN"
  DESCRIPTION = "Date de fin du dernier traitement"
  DATA_TYPE = "DATE"
  DATE_VALUE = "01/01/2005 00:00:00"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SPORECEP" "MODE_CODE"
  DESCRIPTION = "Code du mode de processus"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "BATCH"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SPORECEP" "SOURCE_CODE"
  DESCRIPTION = "Code sources des commandes"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "VENDOR"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SPORECEP" "STATUS_CODE"
  DESCRIPTION = "Code pour lignes en attente"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "PENDING"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SPORECEP" "TRANSACTION_AUTO"
  DESCRIPTION = "Type de transaction automatique"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "DELIVER"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SPORECEP" "TRANSACTION_NEW"
  DESCRIPTION = "Type pour une nouvelle transaction"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "NEW"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "DKA_SPORECEP" "TRANSACTION_TYPE"
  DESCRIPTION = "Type de transaction"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "RECEIVE"
END DKA_PARAMETER


