    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2008/10/30 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "PO"
    APPLICATION_TABLE_NAME = "PO_LOOKUP_CODES"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "DISPLAYED_FIELD"
    VALUE_COLUMN_TYPE = "C"
    VALUE_COLUMN_SIZE = "80"
    ID_COLUMN_NAME = "LOOKUP_CODE"
    ID_COLUMN_TYPE = "C"
    ID_COLUMN_SIZE = "25"
    MEANING_COLUMN_NAME = "DESCRIPTION"
    MEANING_COLUMN_TYPE = "C"
    MEANING_COLUMN_SIZE = "240"
