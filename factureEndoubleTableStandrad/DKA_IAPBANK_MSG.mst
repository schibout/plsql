BEGIN VALUE_SET "PO_SRS_PO_NUM_FROM"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2007/12/21 00:00:00"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "20"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Lancement standard d'états (SRS) PO - Numéro OA - De"


  BEGIN VSET_TABLE
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2012/01/31 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "PO"
    APPLICATION_TABLE_NAME =
 "PO_HEADERS PH, po_document_types podt, fnd_user fnd,  po_system_parameters  psp"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "PH.SEGMENT1"
    VALUE_COLUMN_TYPE = "C"
    VALUE_COLUMN_SIZE = "20"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "WHERE PH.TYPE_LOOKUP_CODE in ('STANDARD', 'PLANNED', 'CONTRACT', 'BLANKET')\n\
  and fnd.user_id = FND_GLOBAL.user_id\n\
  and    podt.document_type_code =\n\
  decode(ph.type_lookup_code,\n\
  'STANDARD', 'PO', 'PLANNED', 'PO',\n\
  'BLANKET', 'PA', 'CONTRACT', 'PA', NULL)\n\
  and    podt.document_subtype = ph.type_lookup_code\n\
  and    ( ph.agent_id = fnd.employee_id\n\
  OR podt.security_level_code = 'PUBLIC'\n\
  OR EXISTS\n\
  ( SELECT 'This employee is in approval path of this doc'\n\
  FROM   PO_ACTION_HISTORY POAH2\n\
  WHERE  POAH2.employee_id =\n\
  fnd.employee_id\n\
  AND    POAH2.object_id = po_header_id\n\
  AND    POAH2.object_type_code in\n\
  ('PO','PA')\n\
  AND    POAH2.object_sub_type_code =\n\
  ph.type_lookup_code)\n\
  OR\n\
  ( podt.security_level_code = 'PURCHASING'\n\
  AND EXISTS\n\
  (  SELECT 'Is the user an agent'\n\
  FROM   PO_AGENTS POA\n\
  WHERE  POA.AGENT_ID =\n\
  fnd.employee_id\n\
  AND    sysdate between\n\
  nvl(poa.start_date_active,\n\
  sysdate) and\n\
  nvl(poa.end_date_active,\n\
  sysdate + 1)))\n\
  OR\n\
  ( podt.security_level_code = 'HIERARCHY'\n\
  AND fnd.employee_id IN\n\
  ( SELECT POEH.SUPERIOR_ID\n\
  FROM   PO_EMPLOYEE_HIERARCHIES POEH\n\
  WHERE  POEH.EMPLOYEE_ID = PH.AGENT_ID\n\
  AND    POEH.POSITION_STRUCTURE_ID =\n\
  PSP.SECURITY_POSITION_STRUCTURE_ID)))\n\
  ORDER BY DECODE(PSP.manual_po_num_type, 'NUMERIC',\n\
  to_number(PH.segment1)),\n\
  DECODE(PSP.manual_po_num_type, 'ALPHANUMERIC',\n\
  PH.segment1)"
  END VSET_TABLE
  





END VALUE_SET

BEGIN VALUE_SET "PO_SRS_PO_NUM_TO"
  OWNER = "ORACLE12.2.4"
  LAST_UPDATE_DATE = "2007/12/21 00:00:00"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "20"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Lancement standard d'états (SRS) PO - Numéro OA - A"


  BEGIN VSET_TABLE
    OWNER = "ORACLE12.2.4"
    LAST_UPDATE_DATE = "2012/01/31 00:00:00"
    TABLE_APPLICATION_SHORT_NAME = "PO"
    APPLICATION_TABLE_NAME =
 "PO_HEADERS PH, po_document_types podt, fnd_user fnd,  po_system_parameters  psp"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "PH.SEGMENT1"
    VALUE_COLUMN_TYPE = "C"
    VALUE_COLUMN_SIZE = "20"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "WHERE PH.TYPE_LOOKUP_CODE in ('STANDARD', 'PLANNED', 'CONTRACT', 'BLANKET')\n\
  and fnd.user_id = FND_GLOBAL.user_id\n\
  and    podt.document_type_code =\n\
  decode(ph.type_lookup_code,\n\
  'STANDARD', 'PO', 'PLANNED', 'PO',\n\
  'BLANKET', 'PA', 'CONTRACT', 'PA', NULL)\n\
  and    podt.document_subtype = ph.type_lookup_code\n\
  and    ( ph.agent_id = fnd.employee_id\n\
  OR podt.security_level_code = 'PUBLIC'\n\
  OR EXISTS\n\
  ( SELECT 'This employee is in approval path of this doc'\n\
  FROM   PO_ACTION_HISTORY POAH2\n\
  WHERE  POAH2.employee_id =\n\
  fnd.employee_id\n\
  AND    POAH2.object_id = po_header_id\n\
  AND    POAH2.object_type_code in\n\
  ('PO','PA')\n\
  AND    POAH2.object_sub_type_code =\n\
  ph.type_lookup_code)\n\
  OR\n\
  ( podt.security_level_code = 'PURCHASING'\n\
  AND EXISTS\n\
  (  SELECT 'Is the user an agent'\n\
  FROM   PO_AGENTS POA\n\
  WHERE  POA.AGENT_ID =\n\
  fnd.employee_id\n\
  AND    sysdate between\n\
  nvl(poa.start_date_active,\n\
  sysdate) and\n\
  nvl(poa.end_date_active,\n\
  sysdate + 1)))\n\
  OR\n\
  ( podt.security_level_code = 'HIERARCHY'\n\
  AND fnd.employee_id IN\n\
  ( SELECT POEH.SUPERIOR_ID\n\
  FROM   PO_EMPLOYEE_HIERARCHIES POEH\n\
  WHERE  POEH.EMPLOYEE_ID = PH.AGENT_ID\n\
  AND    POEH.POSITION_STRUCTURE_ID =\n\
  PSP.SECURITY_POSITION_STRUCTURE_ID)))\n\
  ORDER BY DECODE(PSP.manual_po_num_type, 'NUMERIC',\n\
  to_number(PH.segment1)),\n\
  DECODE(PSP.manual_po_num_type, 'ALPHANUMERIC',\n\
  PH.segment1)"
  END VSET_TABLE
  





END VALUE_SET

