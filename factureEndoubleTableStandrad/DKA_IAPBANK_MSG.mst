BEGIN PROGRAM "DKA_SPOBON" "DKA"
  OWNER = "CAPTECH"
  LAST_UPDATE_DATE = "2017/07/06"
  USER_CONCURRENT_PROGRAM_NAME = "DKA : Imprimer bon de commande (Portrait)"
  EXEC = "DKA_SPOBON" "DKA"
  EXECUTION_METHOD_CODE = "P"
  ARGUMENT_METHOD_CODE = "4"
  QUEUE_CONTROL_FLAG = "N"
  QUEUE_METHOD_CODE = "I"
  REQUEST_SET_FLAG = "N"
  ENABLED_FLAG = "Y"
  PRINT_FLAG = "Y"
  RUN_ALONE_FLAG = "N"
  SRS_FLAG = "Y"
  DESCRIPTION = "DKA : Impression bon de commande (Portrait)"
  CLASS_APPLICATION = "DKA"
  CONCURRENT_CLASS_NAME = "DALKIA_BONCDE"
  SAVE_OUTPUT_FLAG = "Y"
  REQUIRED_STYLE = "N"
  OUTPUT_PRINT_STYLE = "A4"
  OUTPUT_FILE_TYPE = "PS"
  RESTART = "Y"
  NLS_COMPLIANT = "Y"
  MLS_EXEC = "" ""
  ENABLE_TIME_STATISTICS = "N"
  SRS_FLEX = "DKA" "$SRS$.DKA_SPOBON"
  AUTO_ANNOTATION =
 "/**\n\
  * @param P_report_type Print Selection\n\
  * @rep:paraminfo {@rep:type PO_SRS_POXPRPOP_PRINT_OPTION} {@rep:displayed Y} {@rep:required}\n\
  * @param P_agent_name_num Buyer Name, Employee Number (passing ID)\n\
  * @rep:paraminfo {@rep:type PO_SRS_BUYER_NAME_NUM} {@rep:displayed Y}\n\
  * @param P_po_num_from Purchase Order Numbers From\n\
  * @rep:paraminfo {@rep:type PO_SRS_PO_NUM_FROM} {@rep:displayed Y}\n\
  * @param P_po_num_to Purchase Order Numbers To\n\
  * @rep:paraminfo {@rep:type PO_SRS_PO_NUM_TO} {@rep:displayed Y}\n\
  * @param P_release_num_from Release Numbers From\n\
  * @rep:paraminfo {@rep:type PO_SRS_RELEASE_NUM} {@rep:displayed Y}\n\
  * @param P_release_num_to Release Numbers To\n\
  * @rep:paraminfo {@rep:type PO_SRS_RELEASE_NUM} {@rep:displayed Y}\n\
  * @param P_date_from Release Dates From\n\
  * @rep:paraminfo {@rep:type FND_STANDARD_DATE} {@rep:displayed Y}\n\
  * @param P_date_to Release Dates To\n\
  * @rep:paraminfo {@rep:type FND_STANDARD_DATE} {@rep:displayed Y}\n\
  * @param P_approved_flag Approved\n\
  * @rep:paraminfo {@rep:type AP_SRS_YES_NO_OPT} {@rep:displayed Y}\n\
  * @param P_test_flag Test\n\
  * @rep:paraminfo {@rep:type AP_SRS_YES_NO_OPT} {@rep:displayed Y}\n\
  * @param P_print_releases Print Releases Option\n\
  * @rep:paraminfo {@rep:type AP_SRS_YES_NO_MAND} {@rep:displayed Y}\n\
  * @param P_sortby Sort By\n\
  * @rep:paraminfo {@rep:type PO_SRS_POXPRPOP_SORT} {@rep:displayed Y}\n\
  * @param P_user_id User Id\n\
  * @rep:paraminfo {@rep:type PO_SRS_NUMBER} {@rep:displayed Y}\n\
  * @param P_qty_precision Quantity Precision\n\
  * @rep:paraminfo {@rep:type INV_SRS_PRECISION} {@rep:displayed Y} {@rep:required}\n\
  * @param P_fax_enable Fax Enable\n\
  * @rep:paraminfo {@rep:type PO_SRS_AUTOFAX_YN} {@rep:displayed Y}\n\
  * @param P_fax_num Fax Number\n\
  * @rep:paraminfo {@rep:type 15 Characters} {@rep:displayed Y}\n\
  * @param P_CANCEL_LINE Print Canceled Lines\n\
  * @rep:paraminfo {@rep:type AP_SRS_YES_NO_MAND} {@rep:displayed Y}\n\
  * @param P_BLANKET_LINES Print Releases Only\n\
  * @rep:paraminfo {@rep:type AP_SRS_YES_NO_MAND} {@rep:displayed Y}\n\
  */"
  MULTI_ORG_CATEGORY = "S"
  RECALC_PARAMETERS = "N"


END PROGRAM

