----------------------------------------------------------------------------------------------
-- $$
-- 
-- PROJET           : DALKIA Oracle Applications
-- NOM              : DKA_AP_INTERFACE_REJECTIONS_V.vue
-- DESCRIPTION      : Création de la vue DKA_AP_INTERFACE_REJECTIONS_V
--                    Vue de premier niveau (optimisation de la vue AP_INTERFACE_REJECTIONS_V)
--                    utlisee par les requetes de controle
-- AUTEUR           : C.Gibot (Oracle)
-- DATE DE CREATION : 20/05/2025
-- DOC. ASSOCIEE    :
-- COMMENTAIRE      : A exécuter sous SQLPLUS avec le user APPS
--------------------------------------------------------------------------------------------
-- HISTORIQUE DES MODIFICATIONS
-- Date       Qui Description
-- ---------- --- -------------------------------------------------------------------------

  CREATE OR REPLACE FORCE EDITIONABLE VIEW "APPS"."DKA_AP_INTERFACE_REJECTIONS_V" ("VENDOR_ID", "VENDOR_NUM", "VENDOR_NAME", "VENDOR_SITE_ID", "VENDOR_SITE_CODE", "INVOICE_NUM", "INVOICE_ID", "LINE_NUMBER", "DESCRIPTION", "DISPLAYED_FIELD", "PARENT_TABLE", "PARENT_ID", "REJECT_LOOKUP_CODE", "LAST_UPDATED_BY", "LAST_UPDATE_DATE", "LAST_UPDATE_LOGIN", "CREATED_BY", "CREATION_DATE") AS 
  SELECT AII.VENDOR_ID , AII.VENDOR_NUM , AII.VENDOR_NAME , AII.VENDOR_SITE_ID , AII.VENDOR_SITE_CODE , AII.INVOICE_NUM , AII.INVOICE_ID ,  ALC2.DISPLAYED_FIELD , ALC1.DESCRIPTION , ALC1.DISPLAYED_FIELD , AIR.PARENT_TABLE , AIR.PARENT_ID , AIR.REJECT_LOOKUP_CODE , AIR.LAST_UPDATED_BY , AIR.LAST_UPDATE_DATE , AIR.LAST_UPDATE_LOGIN , AIR.CREATED_BY , AIR.CREATION_DATE 
  FROM AP_INTERFACE_REJECTIONS AIR , AP_INVOICES_INTERFACE AII , AP_LOOKUP_CODES ALC1 , AP_LOOKUP_CODES ALC2 
  WHERE STATUS = 'REJECTED' 
  AND AIR.PARENT_TABLE='AP_INVOICES_INTERFACE' and AII.INVOICE_ID =AIR.PARENT_ID 
  AND ALC1.LOOKUP_TYPE = 'REJECT CODE' AND AIR.REJECT_LOOKUP_CODE = ALC1.LOOKUP_CODE AND ALC2.LOOKUP_TYPE = 'NLS TRANSLATION' AND ALC2.LOOKUP_CODE = 'INVOICE' 
  GROUP BY AII.VENDOR_ID , AII.VENDOR_NUM , AII.VENDOR_NAME , AII.VENDOR_SITE_ID , AII.VENDOR_SITE_CODE , AII.INVOICE_NUM , AII.INVOICE_ID ,  ALC2.DISPLAYED_FIELD , ALC1.DESCRIPTION , ALC1.DISPLAYED_FIELD , AIR.PARENT_TABLE , AIR.PARENT_ID , AIR.REJECT_LOOKUP_CODE , AIR.LAST_UPDATED_BY , AIR.LAST_UPDATE_DATE , AIR.LAST_UPDATE_LOGIN , AIR.CREATED_BY , AIR.CREATION_DATE 
UNION ALL
  SELECT AII.VENDOR_ID , AII.VENDOR_NUM , AII.VENDOR_NAME , AII.VENDOR_SITE_ID , AII.VENDOR_SITE_CODE , AII.INVOICE_NUM , AII.INVOICE_ID ,  TO_CHAR(AILI.LINE_NUMBER) , ALC1.DESCRIPTION , ALC1.DISPLAYED_FIELD , AIR.PARENT_TABLE , AIR.PARENT_ID , AIR.REJECT_LOOKUP_CODE , AIR.LAST_UPDATED_BY , AIR.LAST_UPDATE_DATE , AIR.LAST_UPDATE_LOGIN , AIR.CREATED_BY , AIR.CREATION_DATE 
  FROM AP_INTERFACE_REJECTIONS AIR , AP_INVOICES_INTERFACE AII , AP_LOOKUP_CODES ALC1 , AP_LOOKUP_CODES ALC2 
  , AP_INVOICE_LINES_INTERFACE AILI 
  WHERE STATUS = 'REJECTED' 
  AND AIR.PARENT_TABLE='AP_INVOICE_LINES_INTERFACE' and  AILI.INVOICE_LINE_ID =AIR.PARENT_ID 
  AND ALC1.LOOKUP_TYPE = 'REJECT CODE' AND AIR.REJECT_LOOKUP_CODE = ALC1.LOOKUP_CODE AND ALC2.LOOKUP_TYPE = 'NLS TRANSLATION' AND ALC2.LOOKUP_CODE = 'INVOICE' AND AII.INVOICE_ID = AILI.INVOICE_ID (+) 
  GROUP BY AII.VENDOR_ID , AII.VENDOR_NUM , AII.VENDOR_NAME , AII.VENDOR_SITE_ID , AII.VENDOR_SITE_CODE , AII.INVOICE_NUM , AII.INVOICE_ID , TO_CHAR(AILI.LINE_NUMBER) , ALC1.DESCRIPTION , ALC1.DISPLAYED_FIELD , AIR.PARENT_TABLE , AIR.PARENT_ID , AIR.REJECT_LOOKUP_CODE , AIR.LAST_UPDATED_BY , AIR.LAST_UPDATE_DATE , AIR.LAST_UPDATE_LOGIN , AIR.CREATED_BY , AIR.CREATION_DATE 
  UNION ALL
  SELECT AII.VENDOR_ID, AII.VENDOR_NUM, AII.VENDOR_NAME, AII.VENDOR_SITE_ID, AII.VENDOR_SITE_CODE, AII.INVOICE_NUM, AII.INVOICE_ID,  ALC2.DISPLAYED_FIELD, C.MESSAGE_TEXT DESCRIPTION, C.MESSAGE_TEXT DISPLAYED_FIELD, AIR.PARENT_TABLE, AIR.PARENT_ID, AIR.REJECT_LOOKUP_CODE, AIR.LAST_UPDATED_BY, AIR.LAST_UPDATE_DATE, AIR.LAST_UPDATE_LOGIN, AIR.CREATED_BY, AIR.CREATION_DATE 
  FROM AP_INTERFACE_REJECTIONS AIR, AP_INVOICES_INTERFACE AII, FND_NEW_MESSAGES C
  , AP_LOOKUP_CODES ALC2 
  WHERE STATUS = 'REJECTED' 
  AND AIR.PARENT_TABLE = 'AP_INVOICES_INTERFACE' AND  AII.INVOICE_ID = AIR.PARENT_ID 
  AND AIR.REJECT_LOOKUP_CODE = C.MESSAGE_NAME AND C.LANGUAGE_CODE = USERENV('LANG') 
  AND C.APPLICATION_ID != 200 AND ALC2.LOOKUP_TYPE = 'NLS TRANSLATION' AND ALC2.LOOKUP_CODE = 'INVOICE'  GROUP BY AII.VENDOR_ID, AII.VENDOR_NUM, AII.VENDOR_NAME, AII.VENDOR_SITE_ID, AII.VENDOR_SITE_CODE, AII.INVOICE_NUM, AII.INVOICE_ID,  ALC2.DISPLAYED_FIELD, C.MESSAGE_TEXT, AIR.PARENT_TABLE, AIR.PARENT_ID, AIR.REJECT_LOOKUP_CODE, AIR.LAST_UPDATED_BY, AIR.LAST_UPDATE_DATE, AIR.LAST_UPDATE_LOGIN, AIR.CREATED_BY, AIR.CREATION_DATE
  UNION ALL SELECT AII.VENDOR_ID, AII.VENDOR_NUM, AII.VENDOR_NAME, AII.VENDOR_SITE_ID, AII.VENDOR_SITE_CODE, AII.INVOICE_NUM, AII.INVOICE_ID, TO_CHAR(AILI.LINE_NUMBER), C.MESSAGE_TEXT DESCRIPTION, C.MESSAGE_TEXT DISPLAYED_FIELD, AIR.PARENT_TABLE, AIR.PARENT_ID, AIR.REJECT_LOOKUP_CODE, AIR.LAST_UPDATED_BY, AIR.LAST_UPDATE_DATE, AIR.LAST_UPDATE_LOGIN, AIR.CREATED_BY, AIR.CREATION_DATE 
  FROM AP_INTERFACE_REJECTIONS AIR, AP_INVOICES_INTERFACE AII, FND_NEW_MESSAGES C
  , AP_LOOKUP_CODES ALC2, AP_INVOICE_LINES_INTERFACE AILI 
  WHERE STATUS = 'REJECTED' 
  AND AIR.PARENT_TABLE = 'AP_INVOICE_LINES_INTERFACE' AND  AILI.INVOICE_LINE_ID = AIR.PARENT_ID 
  AND AIR.REJECT_LOOKUP_CODE = C.MESSAGE_NAME AND C.LANGUAGE_CODE = USERENV('LANG') 
  AND C.APPLICATION_ID != 200 AND ALC2.LOOKUP_TYPE = 'NLS TRANSLATION' AND ALC2.LOOKUP_CODE = 'INVOICE' AND AII.INVOICE_ID = AILI.INVOICE_ID(+) GROUP BY AII.VENDOR_ID, AII.VENDOR_NUM, AII.VENDOR_NAME, AII.VENDOR_SITE_ID, AII.VENDOR_SITE_CODE, AII.INVOICE_NUM, AII.INVOICE_ID, TO_CHAR(AILI.LINE_NUMBER), C.MESSAGE_TEXT, AIR.PARENT_TABLE, AIR.PARENT_ID, AIR.REJECT_LOOKUP_CODE, AIR.LAST_UPDATED_BY, AIR.LAST_UPDATE_DATE, AIR.LAST_UPDATE_LOGIN, AIR.CREATED_BY, AIR.CREATION_DATE
  ;
EXIT;
/