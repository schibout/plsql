# PHENIX 2004 : SFE
# Modification du parametre "ICODEPROJET" / "GL_RESPONSIBILITY_KEY"
# "GL" -> "DKA_GENERAL_LEDGER_SUPER_USER".

LANGUAGE = "US"
LDRCONFIG = "DKA_XX_PARAM.lct"

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 

BEGIN DKA_PARAMETER "ICODEPROJET" "PROJECT_STATUS_NAME_ACTIF"
  DESCRIPTION = "Projet en statut actif"
  TABLE_NAME = "PA_PROJECT_STATUSES"
  COLUMN_NAME = "PROJECT_STATUS_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Actif"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "ICODEPROJET" "PROJECT_STATUS_NAME_CLOSED"
  DESCRIPTION = "Projet en statut fermé"
  TABLE_NAME = "PA_PROJECT_STATUSES"
  COLUMN_NAME = "PROJECT_STATUS_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Fermé"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "ICODEPROJET" "PROJECT_STATUS_NAME_ENCLOSED"
  DESCRIPTION = "Projet en statut clôturé"
  TABLE_NAME = "PA_PROJECT_STATUSES"
  COLUMN_NAME = "PROJECT_STATUS_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "Clôturé"
END DKA_PARAMETER
