BEGIN LOOKUP_TYPE "CRASH_STATUS"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Statut d'approbation suite à une panne"
  ITEM_TYPE = "WFSTD"

  BEGIN LOOKUP_CODE "APPROVED"
    MEANING = "Approuver"
    DESCRIPTION = "Approuver"
  END LOOKUP_CODE
END LOOKUP_TYPE

BEGIN LOOKUP_TYPE "CSTCELU"
  PROTECT_LEVEL = "100"
  CUSTOM_LEVEL = "100"
  DISPLAY_NAME = "Code express d'élément de coût"
  DESCRIPTION = "Code express pour les éléments de coût. Ce code est utilisé p\
our la valorisation au coût standard et\n\
au coût moyen."
  ITEM_TYPE = "WFSTD"

  BEGIN LOOKUP_CODE "1"
    MEANING = "1"
    DESCRIPTION = "1 indique un élément de coût matières."
  END LOOKUP_CODE

  BEGIN LOOKUP_CODE "2"
    MEANING = "2"
    DESCRIPTION = "2 indique un élément de coût frais généraux matières."
  END LOOKUP_CODE

  BEGIN LOOKUP_CODE "3"
    MEANING = "3"
    DESCRIPTION = "3 indique un élément de coût ressource."
  END LOOKUP_CODE

  BEGIN LOOKUP_CODE "4"
    MEANING = "4"
    DESCRIPTION = "4 indique un élément de coût sous-traitance."
  END LOOKUP_CODE

  BEGIN LOOKUP_CODE "5"
    MEANING = "5"
    DESCRIPTION = "5 indique un élément de coût frais généraux."
  END LOOKUP_CODE
END LOOKUP_TYPE

BEGIN LOOKUP_TYPE "CSTGENLU"
  PROTECT_LEVEL = "0"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "Code express pour -1"
  DESCRIPTION = "Ce code express correspond à la valeur -1."
  ITEM_TYPE = "WFSTD"

  BEGIN LOOKUP_CODE "-1"
    MEANING = "-1"
    DESCRIPTION = "-1 indique l'utilisation de comptes par défaut."
  END LOOKUP_CODE
END LOOKUP_TYPE

