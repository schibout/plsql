BEGIN ACTIVITY "DKASPAPR" "DKAPROCESSAPPRO"
  PROTECT_LEVEL = "1000"
  CUSTOM_LEVEL = "0"
  DISPLAY_NAME = "DKA : Process Maître d'approbation des modifications de cont\
rats SSTR"
  TYPE = "PROCESS"
  RESULT_TYPE = "*"
  RERUN = "RESET"
  COST = "0"
  ICON_NAME = "PROCESS.ICO"
  ERROR_ITEM_TYPE = "WFERROR"
  RUNNABLE = "Y"

  BEGIN PROCESS_ACTIVITY "START"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "START"
    START_END = "START"
    ICON_GEOMETRY = "-864,-656"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "ASSIGN-CONTRAT"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-864,-656:-864,-832:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "ASSIGN-CONTRAT"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "ASSIGN"
    ICON_GEOMETRY = "-864,-832"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ATTR"
      VALUE_TYPE = "CONSTANT"
      VALUE = "COMMANDE_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "DATE_VALUE"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "NUMBER_VALUE"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "P_CONTRACT_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "TEXT_VALUE"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "DKA_SPO_LANCE_APPROBATION"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-864,-832:-720,-832:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_SPO_LANCE_APPROBATION"
    ACTIVITY_ITEM_TYPE = "DKASPAPR"
    ACTIVITY_NAME = "DKA_SPO_LANCE_APPROBATION"
    ICON_GEOMETRY = "-720,-832"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "SUCCESS" "WAITFORFLOW-CONTRAT"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-720,-832:-544,-832:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "FAIL" "END-ECHEC"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-720,-832:-720,-272:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_SPO_ARCHIVAGE_CONTRAT"
    ACTIVITY_ITEM_TYPE = "DKASPAPR"
    ACTIVITY_NAME = "DKA_SPO_ARCHIVAGE_CONTRAT"
    ICON_GEOMETRY = "-240,-832"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "DKA_SPO_DIMINUTION_QUANTITE"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-240,-832:-240,-704:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_SPO_DIMINUTION_QUANTITE"
    ACTIVITY_ITEM_TYPE = "DKASPAPR"
    ACTIVITY_NAME = "DKA_SPO_DIMINUTION_QUANTITE"
    ICON_GEOMETRY = "-240,-704"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "Y" "DKA_SPO_CORRECTION_RECEPTION"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-240,-704:64,-704:"
    END ACTIVITY_TRANSITION

    BEGIN ACTIVITY_TRANSITION "N" "DKA_SPO_MODIFICATION_COMMANDE"
      ARROW_GEOMETRY = "0;0;0;0;0.500000;-240,-704:-240,-384:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "DKA_SPO_CORRECTION_RECEPTION"
    ACTIVITY_ITEM_TYPE = "DKASPAPR"
    ACTIVITY_NAME = "DKA_SPO_CORRECTION_RECEPTION"
    ICON_GEOMETRY = "64,-704"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_TRANSITION "*" "SUBMITCONCPROG-1"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;64,-704:240,-704:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "WAITFORFLOW-CONTRAT"
    ACTIVITY_ITEM_TYPE = "WFSTD"
    ACTIVITY_NAME = "WAITFORFLOW"
    ICON_GEOMETRY = "-544,-832"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "CONTINUATION_ACTIVITY"
      VALUE_TYPE = "CONSTANT"
      VALUE = "CONTINUEFLOW-CONTRAT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "CONTINUATION_FLOW"
      VALUE_TYPE = "CONSTANT"
      VALUE = "DETAIL"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_TRANSITION "*" "DKA_SPO_CONTROLE_STATUT"
      ARROW_GEOMETRY = "1;0;0;0;0.500000;-544,-832:-400,-832:"
    END ACTIVITY_TRANSITION
  END PROCESS_ACTIVITY

  BEGIN PROCESS_ACTIVITY "SUBMITCONCPROG-1"
    ACTIVITY_ITEM_TYPE = "FNDCMSTD"
    ACTIVITY_NAME = "SUBMITCONCPROG"
    ICON_GEOMETRY = "240,-704"
    VALUE_TYPE = "CONSTANT"

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "APPLNAME"
      VALUE_TYPE = "CONSTANT"
      VALUE = "PO"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "PROGRAM"
      VALUE_TYPE = "CONSTANT"
      VALUE = "RVCTP"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "NUMBEROFARGS"
      VALUE_TYPE = "CONSTANT"
      VALUE = "2"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "REQIDNAME"
      VALUE_TYPE = "CONSTANT"
      VALUE = "REQUEST_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ARG1"
      VALUE_TYPE = "CONSTANT"
      VALUE = "BATCH"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ARG2"
      VALUE_TYPE = "ITEMATTR"
      VALUE = "BATCH_ID"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ARG3"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ARG4"
      VALUE_TYPE = "CONSTANT"
    END ACTIVITY_ATTRIBUTE_VALUE

    BEGIN ACTIVITY_ATTRIBUTE_VALUE "ARG5"
