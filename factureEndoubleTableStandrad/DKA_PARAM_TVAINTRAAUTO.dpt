# $Header$

# 
LANGUAGE = "F"
LDRCONFIG = "DKA_XX_PARAM.lct"

#Source Database HELDEV

#RELEASE_NAME 12.2.4

# -- Begin Entity Definitions -- 

DEFINE DKA_PARAMETER
  KEY   PROGRAM_CODE                    VARCHAR2(50)
  KEY   PARAMETER_NAME                  VARCHAR2(50)
  BASE  DESCRIPTION                     VARCHAR2(255)
  BASE  TABLE_NAME                      VARCHAR2(100)
  BASE  COLUMN_NAME                     VARCHAR2(100)
  BASE  DATA_TYPE                       VARCHAR2(100)
  BASE  VARCHAR2_VALUE                  VARCHAR2(50)
  BASE  NUMBER_VALUE                    VARCHAR2(30)
  BASE  DATE_VALUE                      VARCHAR2(19)
  BASE  BOOLEAN_VALUE                   VARCHAR2(1)
END DKA_PARAMETER

# -- End Entity Definitions -- 



BEGIN DKA_PARAMETER "SARSURTAXE" "GL_SEGMENT3_LIST"
  DESCRIPTION = "Liste des valeurs du segment3 à extraire"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "'467300', '467296'"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARSURTAXE" "GL_SEGMENT4_LIKE"
  DESCRIPTION = "Modèle des valeurs du segment4 à extraire"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "CSC%"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARSURTAXE" "JE_SOURCE_NAME"
  DESCRIPTION = "la source du journal pour le spécifique SARSURTAXE"
  TABLE_NAME = "GL_JE_SOURCES"
  COLUMN_NAME = "USER_JE_SOURCE_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "SURTAXE"
END DKA_PARAMETER

BEGIN DKA_PARAMETER "SARSURTAXE" "LINE_TYPE_CODE"
  DESCRIPTION = "Type de la ligne de la facture"
  TABLE_NAME = "AP_LOOKUP_CODES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "ITEM"
END DKA_PARAMETER


BEGIN DKA_PARAMETER "SARSURTAXE" "SOURCE"
  DESCRIPTION = "Source des factures à importer"
  TABLE_NAME = "AP_LOOKUP_CODES"
  COLUMN_NAME = "LOOKUP_CODE"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "SURTAXE"
END DKA_PARAMETER


BEGIN DKA_PARAMETER "SARSURTAXE" "USER_JE_CATEGORY_NAME"
  DESCRIPTION = "Catégorie du journal pour le spécifique SARSURTAXE"
  TABLE_NAME = "GL_JE_CATEGORIES"
  COLUMN_NAME = "USER_JE_CATEGORY_NAME"
  DATA_TYPE = "VARCHAR2"
  VARCHAR2_VALUE = "SURTAXE OD"
END DKA_PARAMETER

