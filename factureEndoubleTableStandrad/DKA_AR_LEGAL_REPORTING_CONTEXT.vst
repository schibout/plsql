# $Header$

# dbdrv: exec fnd bin FNDLOAD bin &phase=daa+52 checkfile:~PROD:~PATH:~FILE &ui_apps 0 Y UPLOAD @FND:patch/115/import/afmdmsg.lct @~PROD:~PATH/~FILE
LANGUAGE = "F"
LDRCONFIG = "afmdmsg.lct 115.26"

#Source Database REF1HEL

# -- Begin Entity Definitions -- 

DEFINE FND_NEW_MESSAGES
  KEY   APPLICATION_SHORT_NAME          VARCHAR2(50)
  KEY   MESSAGE_NAME                    VARCHAR2(30)
  CTX   OWNER                           VARCHAR2(4000)
  BASE  LAST_UPDATE_DATE                VARCHAR2(10)
  CTX   MESSAGE_NUMBER                  VARCHAR2(50)
  TRANS MESSAGE_TEXT                    VARCHAR2(2000)
  CTX   DESCRIPTION                     VARCHAR2(240)
  CTX   TYPE                            VARCHAR2(30)
  CTX   MAX_LENGTH                      NUMBER(22)
  CTX   CATEGORY                        VARCHAR2(10)
  CTX   SEVERITY                        VARCHAR2(10)
  CTX   FND_LOG_SEVERITY                NUMBER(22)
END FND_NEW_MESSAGES

# -- End Entity Definitions -- 


BEGIN FND_NEW_MESSAGES "DKA" "DKA_SAPSUIVI_NOTIF_SUJET"
  OWNER = "USER"
  LAST_UPDATE_DATE = "2008/09/16"
  MESSAGE_TEXT =
 "=?iso-8859-1?Q?R=E9capitulatif_des_notifications_=E0_traiter_et_valider?="
  TYPE = "OTHER"
END FND_NEW_MESSAGES

BEGIN FND_NEW_MESSAGES "DKA" "DKA_SAPSUIVI_NOTIF_DEB_CORPS"
  OWNER = "RROUX"
  LAST_UPDATE_DATE = "2009/01/26"
  MESSAGE_TEXT =
 "Bonjour,<br/><br/>\n\
Veuillez, trouvez ci-joint la liste des factures bloquées qui requierent votre intervention ainsi que la liste \n\
des DA/Commandes qui nécessitent votre approbation.<br/>\n\
Vous avez &NBFACTURE facture(s) et &NBNOTIF notification(s) en attente de traitement dans SSP.<br/> \n\
Vous avez &NBDA DA et commandes en attente de traitement dans SSP.<br/> \n\
Ce message est un message d'information, merci de vous connecter a l'application permettant \n\
de traiter les notifications via le lien ci-dessous.<br/><br/>\n\
\n\
<a href='&URL_LOGIN'>Acces a Oracle Applications.</a><br/>\n\
"
  TYPE = "OTHER"
END FND_NEW_MESSAGES

BEGIN FND_NEW_MESSAGES "DKA" "DKA_SAPSUIVI_NOTIF_FIN_CORPS"
  OWNER = "RROUX"
  LAST_UPDATE_DATE = "2009/01/26"
  MESSAGE_TEXT =
 "<br/>\n\
Merci de traiter ces notifications dans les plus brefs délais.<br/>\n\
<br/>\n\
<b>Rappel : tout traitement non effectué sera relancé automatiquement dans 10 jours calendaire</b><br/>\n\
<br/>\n\
Cordialement,<br/>\n\
<p>PS : Ce message est envoyé en automatique, il est inutile d'y répondre. \n\
Il est régénéré  automatiquement tous les matins tant que des notifications vous étant adressées resteront ouvertes. \n\
Pour toute question, merci de contacter le CSP Fournisseur de votre région ou les approvisionneurs.</p>"
  TYPE = "OTHER"
END FND_NEW_MESSAGES

