BEGIN FND_FORM_CUSTOM_RULES "1033"
  FUNCTION_NAME = "AP_APXINWKB"
  DESCRIPTION =
 "EdB094_Oracle_R12_Gestion des doublons AP Numeros de Pieces Sites differents (Defect 828)"
  TRIGGER_EVENT = "WHEN-VALIDATE-RECORD"
  TRIGGER_OBJECT = "INV_SUM_FOLDER"
  CONDITION =
 "(SELECT count(1)\n\
    FROM  ap_invoices_all api,\n\
          ap_suppliers pv,\n\
          ap_supplier_sites pvs\n\
    WHERE api.invoice_num = :INV_SUM_FOLDER.invoice_num\n\
    AND api.vendor_id = pv.vendor_id\n\
    AND pvs.vendor_site_code  != NVL(:INV_SUM_FOLDER.vendor_site_code, 'NULL')\n\
    AND pvs.vendor_id = pv.vendor_id\n\
    AND pv.segment1 = :INV_SUM_FOLDER.vendor_number\n\
    AND api.invoice_date = :INV_SUM_FOLDER.invoice_date\n\
    AND api.invoice_amount = :INV_SUM_FOLDER.invoice_amount\n\
    AND api.rowid != :INV_SUM_FOLDER.ROW_ID\n\
) > 0"
  SEQUENCE = "40"
  CREATED_BY = "1301"
  CREATION_DATE = "2018/08/24"
  OWNER = "NBOUSSEK"
  LAST_UPDATE_DATE = "2018/08/24"
  LAST_UPDATE_LOGIN = "-1"
  ENABLED = "Y"
  FIRE_IN_ENTER_QUERY = "Y"
  FORM_NAME = "APXINWKB"
  RULE_TYPE = "F"

