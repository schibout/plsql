---------------------------------------------------------------------------------------------- 
-- $$
-- CAPGEMINI 
-- PROJET           : DALKIA Oracle Applications
-- NOM              : DKA_CONTRAT_SSTR_NUM.seq
-- DESCRIPTION	    : Création de la séquence DKA_CONTRAT_SSTR_NUM
--
-- AUTEUR           : NBO (CAPGEMINI)
-- DATE DE CREATION : 24/08/2017
-- DOC. ASSOCIEE    : 
-- COMMENTAIRE      : A exécuter sous SQLPLUS avec le user DKA
--                    en lui passant les paramètres :
--                           1) Password DKA
--                           2) Password APPS
--                           
--                           
--------------------------------------------------------------------------------------------
-- HISTORIQUE DES MODIFICATIONS
-- Date       Qui Description
-- ---------- --- -------------------------------------------------------------------------
-- 
--------------------------------------------------------------------------------------------

CONNECT DKA/&1



PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT SUPPRESSION DE LA SEQUENCE 
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP SEQUENCE DKA_CONTRAT_SSTR_NUM;

PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT CREATION DE LA SEQUENCE 
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

CREATE SEQUENCE DKA_CONTRAT_SSTR_NUM
INCREMENT BY 1
START WITH 1 ;

PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT CREATION DES GRANTS
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


GRANT ALL ON DKA_CONTRAT_SSTR_NUM TO APPS WITH GRANT OPTION;

PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
PROMPT CREATION DU SYNONYME
PROMPT ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CONNECT APPS/&2

DROP SYNONYM DKA_CONTRAT_SSTR_NUM;
CREATE SYNONYM DKA_CONTRAT_SSTR_NUM FOR dka.DKA_CONTRAT_SSTR_NUM;

EXIT;

