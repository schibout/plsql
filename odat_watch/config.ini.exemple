; Copier en config.ini et renseigner. config.ini est ignore par git : ne jamais mettre de mot de passe ici.
[database]
; Compte Oracle (nominatif ou APPS). Les vues FND doivent etre accessibles sans prefixe,
; sinon renseigner schema = APPS.
user = mon_compte
password = XXXXXXXX
; Format host:port/service_name
dsn = prdscanc1pdb03.dalkia.net:1521/ebs_PDBFINP1
schema = APPS
; Mode de connexion : auto (thin, ou thick si client_dir renseigne) | thin | thick
; Erreur DPY-3015 (verificateur de mot de passe 10g) => obligatoirement thick :
; dezipper un Instant Client 64 bits (Basic Light suffit, 19c ou plus) et indiquer son dossier.
mode = auto
client_dir =
; exemple : client_dir = C:\oracle\instantclient_21_13

[oracle]
; Fenetre d'historique recuperee a chaque rafraichissement (heures)
; Premier chargement des demandes : N jours d'historique (tout ce que FND conserve) ; ensuite seul le delta
; (request_id > dernier charge, demandes modifiees, en attente / en cours) est charge.
jours_initial = 365
heures_historique = 48
; Filtre LIKE sur la DESCRIPTION des demandes (nom du job Control-M). Vide = toutes.
; Vide = toutes les applications (necessaire pour rapprocher toutes les photos ODAT). Ex. : FIN%
filtre_description =
; Programmes a suivre meme s'ils ne passent pas par Control-M (liste separee par des virgules, vide = aucun)
programmes_suivis = RBAFBIMP,DKA_SRBCTRLRB
; Programmes generiques (lanceurs) : jamais comptes ni affiches dans les controles de nuit / du matin
programmes_generiques = DKA_SLAUNCHER

[logs]
; Dossiers locaux ou sont deposes les l<request_id>.req et o<request_id>.out rapatries du serveur EBS
; (plusieurs dossiers separes par ; ). Sous-dossiers inclus.
dossiers = ..\ControleReleveBancaire\import;..\ControleReleveBancaire\controle;logs_ebs

[releves]
; Onglet Releves bancaires. Dossiers locaux alimentes a la main (copie des executions PFE, copy_ebs_logs.sh).
; Un sous-dossier <uuid> par execution Talend (SOURCE / TARGET / TALEND)
dossier_pfe = ..\ControleReleveBancaire\fluxPFE
; Fichiers AFB120.txt_<AAAAMMJJHHMMSS> recus par EBS (data/traite)
dossier_ebs = ..\ControleReleveBancaire\fichierBanque
; Logs l<request_id>.req / o<request_id>.out des imports RBAFBIMP et des controles DKA_SRBCTRLRB (separes par ;)
dossiers_logs = ..\ControleReleveBancaire\import;..\ControleReleveBancaire\controle
; Flux B = fichier ne contenant que cette banque (Societe Generale)
banque_flux_b = 30003
; Comptes en anomalie preexistante, ignores par le verdict (banque/guichet/compte, separes par ;)
comptes_connus = 30003/03620/00020137269;16807/00166/31990892212

[virements]
; Onglet Virements. Code de l'outil (controle_virements.py)
outil = ..\controleVirement
; Donnees : un dossier JJMMAAAA par jour (un sous-dossier par instance : SOURCE, TALEND, TARGET), fichier Quartz
; "Liste des virements importes du jour<date>.xls" ; les rapports rapport_<date> y sont ecrits. Hors git.
racine = ..\ODAT\virements
; Recherche des envois deja transmis dans les autres dossiers *_cible des N jours precedents (0 = desactive)
historique_jours = 7

[prelevements]
; Onglet Prelevements. Code de l'outil (rapprochement_cle_metier.py)
outil = ..\CTRL_QUASI_AUTOMATIQUE_DES_PRELEVEMENTS
; Donnees : dossiers ORACLE\<AAAAMMJJ> (fichiers *PCX* / *PCL* archives depuis DATA/Traite/OUT_SEPA), EDF
; (IMPORT_AVP_DK.*.csv, pieces jointes du mail "Synthese quotidienne des prelevements Dalkia recus par CashCollection")
; et EDF\REJETS (REJETS_INTERNES_DK.*.csv). Rapports ecrits dans rapport\Rapprochement_Cle_Metier_<AAAAMMJJ>_<HHMMSS>.*
; Hors git.
racine = ..\ODAT\prelevements
; Profondeur du perimetre en jours calendaires (echeances de reference - jours a reference + 25 j)
jours = 10
; Nom du SI dans les etats EDF (l'autre SI est CIF)
nom_si = ORACLE
