<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Tableau de bord quotidien FIN-FINANCE (Control-M)</Description>
    <Author>Dalkia Finance</Author>
  </RegistrationInfo>
  <Triggers>
    <!-- Chaque matin à 08h30, du lundi au vendredi -->
    <CalendarTrigger>
      <StartBoundary>2026-04-17T08:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Rapport hebdomadaire le vendredi à 20h00 -->
    <CalendarTrigger>
      <StartBoundary>2026-04-17T20:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Friday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions>
    <!-- Action 1 : consolidation + dashboard quotidien (08h30) -->
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-ExecutionPolicy Bypass -NonInteractive -File "C:\Users\schibout\Documents\plsql\AnalyseTraitements\consolidate_finance.ps1"</Arguments>
      <WorkingDirectory>C:\Users\schibout\Documents\plsql\AnalyseTraitements</WorkingDirectory>
    </Exec>
  </Actions>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
</Task>
