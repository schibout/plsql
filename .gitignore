# =====================================================================
# Règle générale : ignorer les fichiers sans extension
# =====================================================================
# ATTENTION : Cette section ignore par défaut les fichiers sans extension
# (ex: Makefile, Dockerfile, scripts shell sans extension, etc.).

# 1. On ignore tout par défaut
*
# 2. On ré-inclut les dossiers pour que git puisse les parcourir
!*/
# 3. On ré-inclut les fichiers qui ont une extension (contenant un point)
!*.*
# 4. On s'assure que le fichier .gitignore lui-même est bien suivi
!.gitignore

# =====================================================================
# Fichier .gitignore pour les projets PL/SQL et scripts d'analyse
# =====================================================================


# 2. Ignorer les fichiers de log
*.log
odat_watch/odat.db
# 3. Ignorer les dossiers de rapport générés par les outils
rapport_*/
Logs/

# 4. Ignorer les dossiers de cache Python
#    (générés par l'exécution de scripts comme controle_virements.py)
__pycache__/

# 5. Ignorer les fichiers texte génériques
#    (exports, notes, etc.)

extractionCap/*.xlsx

# Rapports HTML du controle du matin (ODAT Watch)
odat_watch/rapports/

# Captures Playwright (MCP)
.playwright-mcp/

# Caches pytest
.pytest_cache/

# Donnees de production des controles bancaires (IBAN, RUM, montants) et leurs rapports : jamais dans git
ODAT/virements/
ODAT/prelevements/
ODAT/releve_bancaire/
ODAT/GDR/
CTRL_QUASI_AUTOMATIQUE_DES_PRELEVEMENTS/rapport/

# Caches pytest (odat_watch)
odat_watch/.pytest_cache/

# clasp : liaison locale au projet Apps Script (propre au poste / au compte)
Projet_Virements/.clasp.json
Projet_CTM/.clasp.json
Projet_Dashboard/.clasp.json
Projet_Dashboard/.deployment_id
Projet_Dashboard/config.bat
